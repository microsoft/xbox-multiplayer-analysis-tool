<Window x:Class="XMAT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XMAT"
        xmlns:proxy="clr-namespace:XMAT.WebServiceCapture"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing"
        Title="{StaticResource appName}"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="{DynamicResource BaseFontSize}"
        UseLayoutRounding="{local:Look New=True, Original=False}"
        AllowDrop="True"
        Drop="Window_Drop"
        WindowStartupLocation="CenterScreen"
        d:Height="720" d:Width="1280" >
    <Window.CommandBindings>
        <CommandBinding Command="New"  Executed="New_Executed" CanExecute="CaptureDataCommand_CanExecute"/>
        <CommandBinding Command="Open" Executed="Open_Executed" CanExecute="CaptureDataCommand_CanExecute"/>
        <CommandBinding Command="Save" Executed="Save_Executed" CanExecute="CaptureDataCommand_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.Import}"           Executed="Import_Executed" CanExecute="Import_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.Export}"           Executed="Export_Executed" CanExecute="Export_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.ExportSanitized}"  Executed="Export_Executed" CanExecute="Export_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.Preferences}"      Executed="Preferences_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.Exit}"             Executed="Exit_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.ClearAllCaptures}" Executed="ClearAllCaptures_Executed" CanExecute="ClearAllCaptures_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.AnalyzeCaptures}"  Executed="AnalyzeCaptures_Executed" CanExecute="AnalyzeCaptures_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.ExportAnalysisReport}" Executed="ExportAnalysisReport_Executed" CanExecute="ExportAnalysisReport_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.CollectLogs}"      Executed="CollectLogs_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.ViewGDKXInfo}"      Executed="ViewGDKXInfo_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.ExportRootCert}"   Executed="ExportRootCert_Executed"/>
        <CommandBinding Command="{x:Static proxy:WebServiceProxyCommands.ChangePort}"
                        Executed="ChangeProxyPort_Executed" CanExecute="ChangeProxyPort_CanExecute"/>
        <CommandBinding Command="{x:Static local:AppCommands.ManageHostLists}" Executed="ManageHostLists_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.ComposeRequest}" Executed="ComposeRequest_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <!-- A labeled on/off switch. It uses only colors both looks define, so it looks the same in either. -->
        <Style x:Key="LookSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="3" Padding="6,1" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,6,0" RecognizesAccessKey="True"/>
                                <Grid Width="26" Height="14" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="7" BorderThickness="1"
                                            BorderBrush="{TemplateBinding Foreground}" Background="Transparent"/>
                                    <Ellipse x:Name="Knob" Width="8" Height="8" Margin="3,0" HorizontalAlignment="Left"
                                             Fill="{TemplateBinding Foreground}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentOnFillBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An icon button in the switch's colors, so it too looks the same in either look: two sparkles. -->
        <Style x:Key="WhatsNewButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="3" Padding="5,1" SnapsToDevicePixels="True">
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{TemplateBinding Foreground}"
                                  Data="M6.5,3 C7.1,7.6 8.4,8.9 13,9.5 C8.4,10.1 7.1,11.4 6.5,16 C5.9,11.4 4.6,10.1 0,9.5 C4.6,8.9 5.9,7.6 6.5,3 Z M13,0 C13.3,2 13.9,2.7 16,3 C13.9,3.3 13.3,4 13,6 C12.7,4 12.1,3.3 10,3 C12.1,2.7 12.7,2 13,0 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{local:Look New=Auto, Original=20}"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="119*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" Background="{DynamicResource MenuBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        <!-- The menu spans the row so its background and border run under the switch on the right. -->
        <Menu Grid.Column="0" Grid.ColumnSpan="2" x:Name="MainMenuBar" Style="{DynamicResource MainMenuBarStyle}"
              VerticalAlignment="Center" HorizontalContentAlignment="Left">
            <MenuItem x:Name="FileMenu" HorizontalAlignment="Left" Header="_File">
                <MenuItem x:Name="FileNewCapture"     Header="_New Capture..."   Command="New"/>
                <MenuItem x:Name="FileLoadCaptures"   Header="_Load Captures..." Command="Open"/>
                <MenuItem x:Name="FileSaveCaptures"   Header="_Save Captures..." Command="Save"/>
                <Separator />
                <MenuItem x:Name="FileImportCaptures" Command="{x:Static local:AppCommands.Import}" />
                <MenuItem x:Name="FileExportCaptures" Command="{x:Static local:AppCommands.Export}" />
                <MenuItem x:Name="FileExportSanitizedCaptures" Command="{x:Static local:AppCommands.ExportSanitized}"
                          ToolTipService.ShowOnDisabled="True"/>
                <Separator />
                <MenuItem x:Name="FileExit"           Command="{x:Static local:AppCommands.Exit}" />
            </MenuItem>
            <MenuItem x:Name="EditMenu" HorizontalAlignment="Left" Header="_Edit">
                <MenuItem x:Name="ViewClearCaptures" Command="{x:Static local:AppCommands.ClearAllCaptures}" />
                <Separator />
                <MenuItem x:Name="ToggleDarkMode" Header="_Dark Mode" IsCheckable="True" Click="SelectTheme_Click"
                          Visibility="{local:Look New=Collapsed, Original=Visible}"/>
                <MenuItem x:Name="AppearanceMenu" Header="_Appearance" Visibility="{local:Look New=Visible, Original=Collapsed}">
                    <MenuItem x:Name="LightThemeMenu" Header="_Light" Tag="Light" IsCheckable="True" Click="SelectTheme_Click"/>
                    <MenuItem x:Name="DarkThemeMenu" Header="_Dark" Tag="Dark" IsCheckable="True" Click="SelectTheme_Click"/>
                    <Separator/>
                    <!-- Comfort view gives the new look room; off, the new look is data-dense. The original look keeps
                         its own spacing, so the item is unavailable there. -->
                    <MenuItem x:Name="ComfortViewMenu" Header="_Comfort view" IsCheckable="True" Click="ComfortView_Click"
                              IsEnabled="{local:Look New=True, Original=False}" ToolTipService.ShowOnDisabled="True"
                              ToolTip="{local:Look New={x:Static local:MainWindow.ComfortViewTooltip}, Original={x:Static local:MainWindow.ComfortViewNewLookOnlyTooltip}}"/>
                </MenuItem>
                <!-- Shown while Windows high contrast sets the colors; the theme chosen above returns once it is off. -->
                <MenuItem x:Name="HighContrastThemeNote" IsEnabled="False" Visibility="Collapsed"/>
                <Separator />
                <MenuItem x:Name="EditPreferences" Command="{x:Static local:AppCommands.Preferences}"/>
            </MenuItem>
            <MenuItem x:Name="AnalysisMenu" HorizontalAlignment="Left" Header="_Analysis">
                <MenuItem x:Name="ViewAnalyzeCaptures"
                          Command="{x:Static local:AppCommands.AnalyzeCaptures}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem x:Name="AnalysisExportReport"
                          Command="{x:Static local:AppCommands.ExportAnalysisReport}"
                          ToolTipService.ShowOnDisabled="True"/>
            </MenuItem>
            <MenuItem x:Name="ActionsMenu" HorizontalAlignment="Left" Header="_Actions">
                <MenuItem x:Name="ChangeProxyPort" Command="{x:Static proxy:WebServiceProxyCommands.ChangePort}"
                          CommandTarget="{Binding ElementName=AllCaptureDevicesPanel}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem x:Name="ManageHostLists" Command="{x:Static local:AppCommands.ManageHostLists}"
                          CommandTarget="{Binding ElementName=AllCaptureDevicesPanel}"
                          Header="{x:Static local:AppCommands.ManageHostListsHeader}"/>
                <MenuItem x:Name="ComposeRequest" Header="_Compose a New Request..."
                          Command="{x:Static local:AppCommands.ComposeRequest}"/>
                <Separator/>
                <MenuItem x:Name="ExportRootCert" Header="_Export Root Certificate to Desktop" Command="{x:Static local:AppCommands.ExportRootCert}" />
            </MenuItem>
            <MenuItem x:Name="HelpMenu" HorizontalAlignment="Left" Header="_Help">
                <MenuItem x:Name="CollectLogs" Command="{x:Static local:AppCommands.CollectLogs}" />
                <MenuItem x:Name="ViewGDKXInfo" Command="{x:Static local:AppCommands.ViewGDKXInfo}" />
            </MenuItem>
        </Menu>
            <!-- What's new and the switch that compares the redesign with the original look stay in the same place in
                 both looks. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                <Button x:Name="WhatsNewButton" Style="{DynamicResource WhatsNewButtonStyle}" Margin="0,0,4,0"
                        VerticalAlignment="Center" Click="WhatsNew_Click"
                        ToolTip="{x:Static local:MainWindow.WhatsNewText}"
                        AutomationProperties.Name="{x:Static local:MainWindow.WhatsNewText}"/>
                <ToggleButton x:Name="NewLookToggle" Style="{DynamicResource LookSwitchStyle}" VerticalAlignment="Center"
                              Checked="NewLookToggle_Changed" Unchecked="NewLookToggle_Changed"/>
            </StackPanel>
        </Grid>


        <Grid Grid.Row="1" Grid.Column="0" x:Name="MainClientArea" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{local:Look New=1, Original=4}"/>
                <RowDefinition Height="{local:Look New=174, Original=200}"/>
            </Grid.RowDefinitions>

            <!-- Capture content and analysis share one flat surface; only the divider line separates them. -->
            <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}"/>
            <local:AllCaptureDevicesTabControl x:Name="AllCaptureDevicesPanel" Grid.Row="0" DeviceTabClosed="AllCaptureDevicesPanel_TabClosed"/>
            <!-- In the new look the divider row is a hairline; the splitter overhangs it so it stays easy to grab. -->
            <GridSplitter x:Name="AnalysisSplitter" Grid.Row="1" Grid.Column="0" Style="{DynamicResource PaneSplitterStyle}" Panel.ZIndex="1"
                          Height="{local:Look New=13, Original=4}" Margin="{local:Look New='0,-6', Original='0'}"
                          ResizeDirection="Rows" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            <local:CaptureAnalysisControl x:Name="CaptureErrorsPanel" Grid.Row="2" AnalysisTabAdded="CaptureErrorsPanel_TabAdded" AnalysisTabClosed="CaptureErrorsPanel_TabClosed"/>
        </Grid>

        <StatusBar Grid.Row="2" Grid.Column="0" x:Name="MainStatusBar" Style="{DynamicResource MainStatusBarStyle}" Grid.ColumnSpan="2">
            <StatusBarItem HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid x:Name="StatusBarPanels">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusBar1" Margin="0,0,16,0" Text="{Binding StatusBarText1}" local:LiveRegion.Mode="Polite"/>
                    <TextBlock x:Name="StatusBar2" Grid.Column="1" Margin="0,0,16,0" Text="{Binding StatusBarText2}"/>
                    <TextBlock x:Name="StatusBar3" Grid.Column="2" Text="{Binding StatusBarText3}" local:LiveRegion.Mode="Polite"
                               ToolTip="{Binding StatusBarText3}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
