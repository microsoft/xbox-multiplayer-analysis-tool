<Window x:Class="XMAT.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wscc="clr-namespace:XMAT.WebServiceCapture"
        xmlns:ntca="clr-namespace:XMAT.NetworkTraceCaptureAnalysis"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        x:Name="PreferencesWindowTitle" Height="360" Width="420">
  <Window.CommandBindings>
    <CommandBinding Command="Save" Executed="Save_Executed" />
  </Window.CommandBindings>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl Grid.Row="0" Padding="10" Margin="0,0,0,12">
      <TabItem x:Name="ProxyTab">
        <wscc:CaptureOptionsFull x:Name="ProxyOptions" />
      </TabItem>
      <TabItem x:Name="TraceTab">
        <ntca:NetworkTraceAnalysisOptions x:Name="TraceOptions" />
      </TabItem>
      <TabItem x:Name="GeneralTab">
        <StackPanel>
          <TextBlock x:Name="LanguageLabel" Margin="0,0,0,4" />
          <ComboBox x:Name="LanguageChoice" Margin="0,0,0,12" />
          <TextBlock x:Name="ThemeLabel" Margin="0,0,0,4" />
          <ComboBox x:Name="ThemeChoice" Margin="0,0,0,12" />
          <TextBlock x:Name="LanguageRestart" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="Save" Width="100" MinHeight="28" IsDefault="True" Command="Save" Margin="0,0,8,0" />
      <Button x:Name="Cancel" Width="100" MinHeight="28" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
