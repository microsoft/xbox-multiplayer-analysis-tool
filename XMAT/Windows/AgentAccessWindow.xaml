<Window x:Class="XMAT.AgentAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="820" MinWidth="600" MinHeight="540"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <DockPanel Margin="0,0,0,8">
        <ToggleButton x:Name="EnableAccess" Click="PolicyChanged_Click" Padding="10,5" DockPanel.Dock="Left" />
        <TextBlock x:Name="AccessStatus" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
      <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,10" />
      <StackPanel x:Name="PolicyControls">
        <Label x:Name="DataLabel" Target="{Binding ElementName=DataSharingChoice}" Padding="0,3" />
        <ComboBox x:Name="DataSharingChoice" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectionChanged="PolicyChoice_SelectionChanged" />
        <Label x:Name="ActionsLabel" Target="{Binding ElementName=ActionsChoice}" Padding="0,9,0,3" />
        <ComboBox x:Name="ActionsChoice" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectionChanged="PolicyChoice_SelectionChanged" />
        <CheckBox x:Name="AutomaticBackups" Click="PolicyChanged_Click" Margin="0,12,0,3">
          <TextBlock x:Name="BackupsLabel" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock x:Name="BackupsHint" TextWrapping="Wrap" Margin="20,0,0,10"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
      </StackPanel>
      <TextBlock x:Name="PersistenceStatus" TextWrapping="Wrap" Margin="0,0,0,10"
                 AutomationProperties.LiveSetting="Polite" />
      <GroupBox x:Name="SetupGroup" Padding="10">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <Label x:Name="ClientLabel" Target="{Binding ElementName=ClientChoice}" Padding="0,0,0,3" />
              <ComboBox x:Name="ClientChoice" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectionChanged="SetupChoice_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <Label x:Name="LaunchLabel" Target="{Binding ElementName=LaunchChoice}" Padding="0,0,0,3" />
              <ComboBox x:Name="LaunchChoice" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectionChanged="SetupChoice_SelectionChanged" />
            </StackPanel>
          </Grid>
          <Label x:Name="SetupViewLabel" Target="{Binding ElementName=SetupViewChoice}" Padding="0,9,0,3" />
          <ComboBox x:Name="SetupViewChoice" SelectionChanged="SetupChoice_SelectionChanged" />
          <TextBox x:Name="Configuration" IsReadOnly="True" FontFamily="Consolas" Height="155" Margin="0,8,0,0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   AutomationProperties.LabeledBy="{Binding ElementName=SetupViewLabel}" />
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="CopyCommand" Click="CopyCommand_Click" Padding="8,4" Margin="0,0,8,0" />
            <Button x:Name="CopyConfiguration" Click="CopyConfiguration_Click" Padding="8,4" />
          </WrapPanel>
          <TextBlock x:Name="SetupHint" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </GroupBox>
      <TextBlock x:Name="CloudDisclosure" TextWrapping="Wrap" Margin="0,12,0,8" />
      <TextBlock x:Name="TrustDisclosure" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock x:Name="BackupDisclosure" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
