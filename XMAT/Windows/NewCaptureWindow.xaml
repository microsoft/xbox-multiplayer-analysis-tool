<Window x:Class="XMAT.NewCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMAT"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource SurfacePanelBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="{DynamicResource BaseFontSize}">
    <!-- New Capture in the new look: the device and the capture type, each chosen from cards that say what the option
         is and what it needs (Styles/ChoiceCards.xaml). Windows/AddDeviceWindow.xaml is the original look's. -->
    <DockPanel Width="720">
        <!-- Add capture and Cancel, under a divider. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderDefaultBrush}"
                Padding="{DynamicResource DialogFooterInset}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton" MinWidth="88" MinHeight="{DynamicResource ControlHeight}"
                        Margin="{DynamicResource InlineGap}" IsDefault="True" Click="AddCapture_Click"/>
                <Button x:Name="CancelButton" MinWidth="88" MinHeight="{DynamicResource ControlHeight}" IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- The cards scroll when the screen is too short for them, so Add capture and Cancel stay in view. -->
        <ScrollViewer x:Name="Body" Focusable="False" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{DynamicResource DialogInset}">
                <!-- Devices: three cards, then two wider ones, 12px apart. -->
                <TextBlock x:Name="DeviceHeading" Style="{DynamicResource SectionTitleStyle}"
                           Margin="{DynamicResource HeadingContentGap}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:ChoiceCard x:Name="ThisPcCard" GroupName="NewCaptureDevice"
                                      Icon="{DynamicResource ThisPcPicture}" Checked="Device_Checked"/>
                    <local:ChoiceCard x:Name="DefaultConsoleCard" Grid.Column="2" GroupName="NewCaptureDevice"
                                      Icon="{DynamicResource DefaultConsolePicture}" Checked="Device_Checked"/>
                    <local:ChoiceCard x:Name="ConsoleByAddressCard" Grid.Column="4" GroupName="NewCaptureDevice"
                                      Icon="{DynamicResource ConsoleByAddressPicture}" Checked="Device_Checked">
                        <!-- The address: a check once it's valid; after a pause in typing, or when the field loses focus, an
                             address that isn't valid shows its error. The text box applies its padding twice, around its border
                             and around its text, after a 1px border and a 2px caret gap: the field is 28px tall, and typed text
                             and the example over it start 9px in, clear of the 14px icon 7px from the right. -->
                        <StackPanel>
                            <TextBlock x:Name="AddressLabel" Margin="{DynamicResource HeadingDescriptionGap}"/>
                            <Grid>
                                <TextBox x:Name="AddressBox" Padding="3,2.5,12,2.5" MinHeight="{DynamicResource ControlHeight}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}"
                                         TextChanged="AddressBox_TextChanged" LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>
                                <TextBlock x:Name="AddressExample" Margin="9,0,25,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border x:Name="AddressErrorOutline" BorderThickness="1" Visibility="Collapsed"
                                        CornerRadius="{DynamicResource InputCornerRadius}" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource ErrorTextBrush}"/>
                                <Path x:Name="AddressValidIcon" Width="14" Height="14" Margin="0,0,7,0" Visibility="Collapsed"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                      Data="M2.5,7.3 L5.6,10.3 L11.5,4.2" Stroke="{DynamicResource SuccessTextBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <!-- An error mark whose line and dot take the field's color. -->
                                <Canvas x:Name="AddressErrorIcon" Width="14" Height="14" Margin="0,0,7,0" Visibility="Collapsed"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse Width="14" Height="14" Fill="{DynamicResource ErrorTextBrush}"/>
                                    <Path Data="M7,3.6 L7,7.9" Stroke="{DynamicResource SurfacePanelBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Fill="{DynamicResource SurfacePanelBrush}">
                                        <Path.Data>
                                            <EllipseGeometry Center="7,10.3" RadiusX="0.9" RadiusY="0.9"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Grid>
                            <TextBlock x:Name="AddressError" Margin="0,4,0,0" Style="{DynamicResource NoticeTextStyle}"
                                       Foreground="{DynamicResource ErrorTextBrush}" local:LiveRegion.Mode="Polite"/>
                        </StackPanel>
                    </local:ChoiceCard>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:ChoiceCard x:Name="GenericDeviceCard" GroupName="NewCaptureDevice"
                                      Icon="{DynamicResource GenericDevicePicture}" Checked="Device_Checked"/>
                    <local:ChoiceCard x:Name="HandheldCard" Grid.Column="2" GroupName="NewCaptureDevice"
                                      Icon="{DynamicResource HandheldPicture}" Checked="Device_Checked"/>
                </Grid>

                <!-- Capture types: each card's note says what it needs on the chosen device. Double-clicking one adds the
                     capture. -->
                <TextBlock x:Name="CaptureTypeHeading" Style="{DynamicResource SectionTitleStyle}" Margin="0,24,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:ChoiceCard x:Name="WebProxyCard" GroupName="NewCaptureType" Orientation="Horizontal"
                                      Icon="{DynamicResource WebProxyPicture}" MouseDoubleClick="CaptureType_MouseDoubleClick"/>
                    <local:ChoiceCard x:Name="NetworkTraceCard" Grid.Column="2" GroupName="NewCaptureType"
                                      Orientation="Horizontal" Icon="{DynamicResource NetworkTracePicture}"
                                      MouseDoubleClick="CaptureType_MouseDoubleClick"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
