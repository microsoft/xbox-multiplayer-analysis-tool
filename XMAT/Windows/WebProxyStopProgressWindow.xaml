<Window x:Class="XMAT.WebProxyStopProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stopping Web Proxy Capture"
        Width="420"
        Height="210"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="16"
               FontWeight="SemiBold"
               Text="{Binding PhaseText}"
               TextWrapping="Wrap"/>
    <ProgressBar Grid.Row="1"
                 Height="18"
                 Margin="0,18,0,14"
                 IsIndeterminate="True"/>
    <TextBlock Grid.Row="2"
               Text="{Binding ElapsedText}"/>
    <TextBlock Grid.Row="3"
               Margin="0,6,0,0"
               Text="{Binding ActiveCallbacksText}"/>
    <TextBlock Grid.Row="4"
               Margin="0,6,0,0"
               Text="{Binding PendingUiUpdatesText}"/>
  </Grid>
</Window>
