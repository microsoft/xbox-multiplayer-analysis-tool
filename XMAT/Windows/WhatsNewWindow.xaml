<Window x:Class="XMAT.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMAT"
        Width="880" Height="610" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="{DynamicResource BaseFontSize}">
    <!-- What's new opens from both looks, so it uses only colors both looks define and its own styles. -->
    <Window.Resources>
        <!-- A topic: a hover fill, and for the topic shown, the page's color with an accent bar at its start. -->
        <Style x:Key="TopicStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,2" Padding="12,7,10,7" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Margin="-12,0,0,0" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{DynamicResource AccentFillBrush}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topics: one per page; selecting one shows its page. -->
        <DockPanel Grid.RowSpan="2" Margin="16,20,8,16">
            <TextBlock x:Name="Heading" DockPanel.Dock="Top" Margin="12,0,0,4" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subheading" DockPanel.Dock="Top" Margin="12,0,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ListBox x:Name="Topics" ItemContainerStyle="{StaticResource TopicStyle}" Background="Transparent"
                     BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Topics_SelectionChanged">
                <ListBox.Resources>
                    <!-- The new look's scroll viewers take the panel color; the topics sit on the window's. -->
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The page: a picture of the change, its name, what it does and where to find it. -->
        <Border Grid.Column="1" Margin="8,20,20,0" Padding="24,24,24,20" CornerRadius="8"
                Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1">
            <StackPanel>
                <Border Height="300" CornerRadius="6" BorderThickness="1" local:SurfaceClip.CornerRadius="6"
                        Background="{DynamicResource SurfaceCanvasBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}">
                    <Image x:Name="PageImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="PageTitle" Margin="0,20,0,8" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="PageBody" TextWrapping="Wrap" LineHeight="20"/>
                <TextBlock x:Name="PageWhere" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Paging: a dot for each page, the page number, and Back and Next; Next becomes Done on the last page. -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="8,14,20,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="PageDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock x:Name="Counter" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                           local:LiveRegion.Mode="Polite"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" MinWidth="88" Margin="0,0,8,0" Padding="12,4" Click="Back_Click"/>
                <Button x:Name="NextButton" MinWidth="88" Padding="12,4" IsDefault="True" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
