<UserControl x:Class="XMAT.XboxLiveCaptureAnalysis.CallRateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:app="clr-namespace:XMAT"
             xmlns:local="clr-namespace:XMAT.XboxLiveCaptureAnalysis"
             xmlns:controls="clr-namespace:XMAT.XboxLiveCaptureAnalysis.ReportViews.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="760">
    <!-- The new look only, once the analysis has endpoints with call frequency limits. Its styles are in
         Styles/AnalysisCharts.xaml. -->
    <Grid x:Name="Section" Margin="0,16,0,12">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding HasRows}" Value="True"/>
                            <Condition Binding="{Binding IsNewLook, Source={x:Static app:LookState.Current}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The title, and a switch between each limit's burst and sustained windows. -->
        <DockPanel Style="{DynamicResource CallRateHeaderStyle}">
            <StackPanel x:Name="WindowSwitch" DockPanel.Dock="Right" Orientation="Horizontal"
                        AutomationProperties.Name="{x:Static local:CallRateView.WindowName}">
                <RadioButton x:Name="BurstWindow" Style="{DynamicResource CallRateFirstSegmentStyle}"
                             Content="{Binding BurstLabel}" IsChecked="{Binding IsBurst}"/>
                <RadioButton x:Name="SustainedWindow" Style="{DynamicResource CallRateLastSegmentStyle}"
                             Content="{Binding SustainedLabel}" IsChecked="{Binding IsSustained}"/>
            </StackPanel>
            <TextBlock Text="{x:Static local:CallRateView.Title}" Style="{DynamicResource CallRateTitleStyle}"/>
        </DockPanel>

        <!-- A row per endpoint: its calls, how often the analyzer found it over the limit, and its chart. The Call rate
             column takes the rest of the table's width, and the charts and their time axis under the last row stretch
             with it; the limits' labels share a column beside the charts, so every chart is as wide as the axis. -->
        <Border Grid.Row="1" Style="{DynamicResource CallRateTableStyle}">
            <StackPanel Grid.IsSharedSizeScope="True">
                <Border Style="{DynamicResource CallRateHeaderBandStyle}">
                    <Grid x:Name="HeaderColumns">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding EndpointColumnWidth, RelativeSource={RelativeSource AncestorType=local:CallRateView}}"/>
                            <ColumnDefinition Width="{x:Static local:CallRateView.CallsColumnWidth}"/>
                            <ColumnDefinition Width="{x:Static local:CallRateView.OverLimitColumnWidth}"/>
                            <ColumnDefinition Width="*" MinWidth="{x:Static local:CallRateView.MinCallRateWidth}"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static local:CallRateView.EndpointHeader}" Style="{DynamicResource CallRateHeaderTextStyle}"/>
                        <Border Style="{DynamicResource CallRateHeaderDividerStyle}"/>
                        <TextBlock Grid.Column="1" Text="{x:Static local:CallRateView.CallsHeader}" Style="{DynamicResource CallRateHeaderTextStyle}"
                                   HorizontalAlignment="Right" Margin="7,0"/>
                        <Border Grid.Column="1" Style="{DynamicResource CallRateHeaderDividerStyle}"/>
                        <TextBlock Grid.Column="2" Text="{x:Static local:CallRateView.OverLimitHeader}" Style="{DynamicResource CallRateHeaderTextStyle}"/>
                        <Border Grid.Column="2" Style="{DynamicResource CallRateHeaderDividerStyle}"/>
                        <TextBlock Grid.Column="3" Text="{x:Static local:CallRateView.CallRateHeader}" Style="{DynamicResource CallRateHeaderTextStyle}"/>
                    </Grid>
                </Border>
                <ItemsControl x:Name="Rows" ItemsSource="{Binding Rows}" Focusable="False"
                              AutomationProperties.Name="{x:Static local:CallRateView.TableName}"
                              ItemContainerStyle="{DynamicResource CallRateRowStyle}"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding EndpointColumnWidth, RelativeSource={RelativeSource AncestorType=local:CallRateView}}"/>
                                    <ColumnDefinition Width="{x:Static local:CallRateView.CallsColumnWidth}"/>
                                    <ColumnDefinition Width="{x:Static local:CallRateView.OverLimitColumnWidth}"/>
                                    <ColumnDefinition Width="*" MinWidth="{x:Static local:CallRateView.MinCallRateWidth}"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="7,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Endpoint}" Style="{DynamicResource CallRateCellTextStyle}"/>
                                    <TextBlock Text="{Binding Detail, TargetNullValue=''}" Style="{DynamicResource CallRateDetailTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Calls}" Style="{DynamicResource CallRateCellTextStyle}"
                                           HorizontalAlignment="Right" Margin="7,0"/>
                                <!-- Screen readers read the badge's own text, such as "1 warning". -->
                                <ContentControl Grid.Column="2" Margin="7,0,4,0" Style="{DynamicResource CallRateBadgeStyle}"
                                                Content="{Binding Badge}" local:IssueBadge.Level="{Binding Level}"
                                                AutomationProperties.Name="{Binding Badge}"/>
                                <Grid Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Limit"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:CallRateChart Margin="7,6,0,6" VerticalAlignment="Top"
                                                            Style="{DynamicResource CallRateChartStyle}" Series="{Binding Series}"/>
                                    <controls:CallRateLimitLabel Grid.Column="1" Margin="0,6" VerticalAlignment="Top"
                                                                 Style="{DynamicResource CallRateLimitLabelStyle}"
                                                                 Series="{Binding Series}" Text="{Binding LimitLabel}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding EndpointColumnWidth, RelativeSource={RelativeSource AncestorType=local:CallRateView}}"/>
                        <ColumnDefinition Width="{x:Static local:CallRateView.CallsColumnWidth}"/>
                        <ColumnDefinition Width="{x:Static local:CallRateView.OverLimitColumnWidth}"/>
                        <ColumnDefinition Width="*" MinWidth="{x:Static local:CallRateView.MinCallRateWidth}"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Limit"/>
                        </Grid.ColumnDefinitions>
                        <controls:CallRateAxis x:Name="Axis" Margin="7,0,0,0" VerticalAlignment="Top"
                                               Style="{DynamicResource CallRateAxisStyle}" Seconds="{Binding Seconds}"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- The hover readout floats over the rows, below the chart and centred on its hairline. -->
        <Canvas x:Name="TipLayer" Grid.Row="1" IsHitTestVisible="False">
            <Border x:Name="Tip" Style="{DynamicResource CallRateTipStyle}" Visibility="Collapsed">
                <TextBlock x:Name="TipText"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
