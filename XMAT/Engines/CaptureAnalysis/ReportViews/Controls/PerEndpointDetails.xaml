<UserControl x:Class="XMAT.XboxLiveCaptureAnalysis.ReportViews.Controls.PerEndpointDetails"
             xmlns:Controls="clr-namespace:XMAT.XboxLiveCaptureAnalysis.ReportViews.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XMAT.XboxLiveCaptureAnalysis.ReportViews.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Expander x:Name="EndpointExpanderTemplate" IsExpanded="True" Background="{DynamicResource ExpanderHeaderBrush}" >
        <Expander.Header>
            <!-- Its menu is filled by the report view for this endpoint when it opens. -->
            <StackPanel x:Name="EndpointHeader" Orientation="Horizontal" Background="Transparent">
                <StackPanel.ContextMenu>
                    <ContextMenu Background="{DynamicResource MenuBackgroundBrush}"
                                 Foreground="{DynamicResource MenuForegroundBrush}"/>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding DisplayName}" />
            </StackPanel>
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding ValidationRulesDetails}" x:Name="EndpointRuleStack">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Controls:PerEndpointRuleDetail Margin="20,0,0,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
</UserControl>
