<UserControl x:Class="XMAT.NetworkTraceCaptureAnalysis.NetworkTraceAnalysisOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding NetworkAnalysisPreferences}">
  <StackPanel Width="300" HorizontalAlignment="Left">
    <StackPanel Orientation="Vertical" Margin="0,5,0,0" HorizontalAlignment="Left">
      <TextBlock FontWeight="Bold" x:Name="PacketsPerSecondLabel" />
      <TextBox x:Name="PacketsPerSecondValue" Width="100"
               Text="{Binding PacketsPerSecondThreshold, Mode=OneWay}"
               HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Vertical" Margin="0,5,0,0" HorizontalAlignment="Left">
      <TextBlock FontWeight="Bold" x:Name="MaxMtuLabel" />
      <TextBox x:Name="MaximumMtuValue" Width="100" Text="{Binding MaximumMTU, Mode=OneWay}"
               HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Vertical" Margin="0,5,0,0" HorizontalAlignment="Left">
      <TextBlock FontWeight="Bold" x:Name="DuplicatePacketLabel" />
      <TextBox x:Name="DuplicateWindowValue" Width="100" Text="{Binding DuplicatePacketWindow, Mode=OneWay}"
               HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
