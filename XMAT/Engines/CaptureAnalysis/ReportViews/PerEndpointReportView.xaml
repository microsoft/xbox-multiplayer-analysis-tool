<UserControl xmlns:Controls="clr-namespace:XMAT.XboxLiveCaptureAnalysis.ReportViews.Controls"
             x:Class="XMAT.XboxLiveCaptureAnalysis.PerEndpointReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XMAT.XboxLiveCaptureAnalysis"
             xmlns:logic="clr-namespace:XMAT.XboxLiveCaptureAnalysis"
             mc:Ignorable="d" 
             ContextMenuOpening="HostListMenuOpening"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Filled for the right-clicked or focused summary row when it opens. -->
        <ContextMenu x:Key="HostListRowMenu"
                     Background="{DynamicResource MenuBackgroundBrush}"
                     Foreground="{DynamicResource MenuForegroundBrush}"/>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToId}" Executed="GoToEndpoint_Id" CanExecute="GoToId_CanExecute"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpoint}" Executed="GoToEndpoint_Executed"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointBfr}" Executed="GoToEndpointBfr_Executed"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointBdr}" Executed="GoToEndpointBdr_Executed"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointCfr}" Executed="GoToEndpointCfr_Executed"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointPdr}" Executed="GoToEndpointPdr_Executed"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointRcr}" Executed="GoToEndpointRcr_Executed"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointSbdr}" Executed="GoToEndpointSbdr_Executed"/>
        <CommandBinding Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointTcr}" Executed="GoToEndpointTcr_Executed"/>
    </UserControl.CommandBindings>
    <ScrollViewer>
        <StackPanel>
            <TextBlock x:Name="SummaryLabel" Text="SUMMARY" FontWeight="Bold"/>
            <Separator/>
            <DataGrid
                x:Name="EndpointSummary"
                IsReadOnly="True"
                ItemsSource="{Binding Summary.Endpoints}"
                AutoGenerateColumns="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource HostListRowMenu}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Endpoint Name" Width="SizeToCells" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding DisplayName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpoint}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Batch Frequency Rule" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    logic:IssueBadge.Count="{Binding BatchFrequencyIssueCount}"
                                    AutomationProperties.Name="{Binding BatchFrequencyIssueCount.AccessibleName}"
                                    ToolTip="{Binding BatchFrequencyIssueCount.AccessibleName}"
                                    Tag="{Binding EndpointName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointBfr}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Burst Detection Rule" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    logic:IssueBadge.Count="{Binding BurstDetectionIssueCount}"
                                    AutomationProperties.Name="{Binding BurstDetectionIssueCount.AccessibleName}"
                                    ToolTip="{Binding BurstDetectionIssueCount.AccessibleName}"
                                    Tag="{Binding EndpointName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointBdr}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Call Frequency Rule" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    logic:IssueBadge.Count="{Binding CallFrequencyIssueCount}"
                                    AutomationProperties.Name="{Binding CallFrequencyIssueCount.AccessibleName}"
                                    ToolTip="{Binding CallFrequencyIssueCount.AccessibleName}"
                                    Tag="{Binding EndpointName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointCfr}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Polling Detection Rule" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    logic:IssueBadge.Count="{Binding PollingDetectionIssueCount}"
                                    AutomationProperties.Name="{Binding PollingDetectionIssueCount.AccessibleName}"
                                    ToolTip="{Binding PollingDetectionIssueCount.AccessibleName}"
                                    Tag="{Binding EndpointName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointPdr}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Repeated Calls Rule" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    logic:IssueBadge.Count="{Binding RepeatedCallsIssueCount}"
                                    AutomationProperties.Name="{Binding RepeatedCallsIssueCount.AccessibleName}"
                                    ToolTip="{Binding RepeatedCallsIssueCount.AccessibleName}"
                                    Tag="{Binding EndpointName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointRcr}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Small Batch Detection Rule" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    logic:IssueBadge.Count="{Binding SmallBatchDetectionIssueCount}"
                                    AutomationProperties.Name="{Binding SmallBatchDetectionIssueCount.AccessibleName}"
                                    ToolTip="{Binding SmallBatchDetectionIssueCount.AccessibleName}"
                                    Tag="{Binding EndpointName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointSbdr}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Throttled Call Rule" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    logic:IssueBadge.Count="{Binding ThrottledCallIssueCount}"
                                    AutomationProperties.Name="{Binding ThrottledCallIssueCount.AccessibleName}"
                                    ToolTip="{Binding ThrottledCallIssueCount.AccessibleName}"
                                    Tag="{Binding EndpointName}"
                                    Command="{x:Static logic:CaptureAnalysisCommands.GoToEndpointTcr}" CommandParameter="{Binding Key}"
                                    />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!-- Each endpoint's call rate against its call frequency limits; the new look only. -->
            <local:CallRateView DataContext="{Binding CallRates}"/>
            <Separator/>
            <TextBlock x:Name="DetailsLabel" Text="DETAILS" FontWeight="Bold"/>
            <Separator/>
            <ItemsControl ItemsSource="{Binding Details.Endpoints}" x:Name="EndpointStack">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Controls:PerEndpointDetails />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
