<Window x:Class="XMAT.WebServiceCapture.VerifyDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verification differences" Width="1000" Height="720" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}">
  <!-- One row's recorded verification, prepared in the background and shown while the row is in its tab
       (VerifyDiffWindow.xaml.cs). -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="IdentityText" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" FontStyle="Italic"
               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    <ScrollViewer Grid.Row="2" Margin="0,6,0,0" MaxHeight="240" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <!-- The text can be selected and copied, as a body in the request details can (docs\web-proxy.md); no undo history
         keeps text that the window cleared. -->
    <TabControl x:Name="DiffTabs" Grid.Row="3" Margin="0,10,0,0">
      <TabItem x:Name="BodyTab" Header="Body">
        <TextBox x:Name="BodyDiffText" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="NoWrap" FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem x:Name="JsonTab" Header="JSON">
        <TextBox x:Name="JsonDiffText" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="NoWrap" FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="CloseButton" MinWidth="90" Margin="4" Padding="8,4" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
