<Window x:Class="XMAT.WebServiceCapture.RequestComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMAT.WebServiceCapture"
        Title="Edit and resend" Width="1120" Height="760" MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="ReplayNotice" Margin="0,0,0,10" TextWrapping="Wrap"/>
    <!-- The parts that a request file left out, until each is supplied with its button; typing never supplies one. -->
    <Border x:Name="OmissionsPanel" Grid.Row="1" Margin="0,0,0,10" Padding="8" BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="OmissionsText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
          <Button x:Name="CompleteMethodButton" Margin="0,0,8,0" Padding="8,2" Click="CompletePart_Click"/>
          <Button x:Name="CompleteUrlButton" Margin="0,0,8,0" Padding="8,2" Click="CompletePart_Click"/>
          <Button x:Name="CompleteHeadersButton" Margin="0,0,8,0" Padding="8,2" Click="CompletePart_Click"/>
          <Button x:Name="CompleteNoHeadersButton" Margin="0,0,8,0" Padding="8,2" Click="CompletePart_Click"/>
          <Button x:Name="CompleteBodyButton" Margin="0,0,8,0" Padding="8,2" Click="CompletePart_Click"/>
          <Button x:Name="CompleteEmptyBodyButton" Margin="0,0,8,0" Padding="8,2" Click="CompletePart_Click"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- Raw mode's warning, shown whenever Raw mode is, in the place of the parts left out, which Raw mode never has. -->
    <Border x:Name="RawWarningPanel" Grid.Row="1" Margin="0,0,0,10" Padding="8" BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}" Visibility="Collapsed">
      <TextBlock x:Name="RawWarningText" TextWrapping="Wrap"/>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid x:Name="RequestEditor">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="3*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Switches between Parsed and Raw mode, first in the editor's Tab order; it converts and asks before any loss. -->
        <Button x:Name="ModeButton" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="8,2" Click="ModeButton_Click"/>
        <Grid Grid.Row="1" Grid.RowSpan="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Label x:Name="MethodLabel" Target="{Binding ElementName=MethodBox}"/>
          <Label x:Name="UrlLabel" Grid.Column="1" Target="{Binding ElementName=UrlBox}"/>
          <TextBox x:Name="MethodBox" Grid.Row="1" Margin="0,0,6,0" VerticalContentAlignment="Center"
                   AutomationProperties.LabeledBy="{Binding ElementName=MethodLabel}"/>
          <TextBox x:Name="UrlBox" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
                   TextChanged="UrlBox_TextChanged" AutomationProperties.LabeledBy="{Binding ElementName=UrlLabel}"/>
          <!-- Raw mode's target origin takes the method's and the URL's place; the URL keeps its text for Parsed mode. -->
          <Label x:Name="RawTargetLabel" Grid.ColumnSpan="2" Target="{Binding ElementName=RawTargetBox}"
                 Visibility="Collapsed"/>
          <TextBox x:Name="RawTargetBox" Grid.Row="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                   Visibility="Collapsed" AutomationProperties.LabeledBy="{Binding ElementName=RawTargetLabel}"/>
        </Grid>
        <Label x:Name="HeadersLabel" Grid.Row="3" Target="{Binding ElementName=HeadersBox}"/>
        <Label x:Name="RawHeadLabel" Grid.Row="3" Target="{Binding ElementName=RawHeadBox}" Visibility="Collapsed"/>
        <TextBox x:Name="HeadersBox" Grid.Row="4" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.LabeledBy="{Binding ElementName=HeadersLabel}"/>
        <!-- Raw mode's head: the request line and header lines, which keep tabs, never wrap, and are counted below. -->
        <TextBox x:Name="RawHeadBox" Grid.Row="4" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed" TextChanged="RawHeadBox_TextChanged"
                 AutomationProperties.LabeledBy="{Binding ElementName=RawHeadLabel}"/>
        <!-- Not live: typing is not announced; refusals go to the status, which is. -->
        <TextBlock x:Name="RawCountsText" Grid.Row="5" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <DockPanel Grid.Row="6" Margin="0,6,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UploadFileButton" Margin="4,0" Padding="8,2" Click="UploadFile_Click"/>
            <Button x:Name="BuildFormButton" Margin="4,0" Padding="8,2" Click="BuildForm_Click"
                    ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="FixContentLengthButton" Margin="4,0" Padding="8,2" Visibility="Collapsed"
                    Click="FixContentLength_Click"/>
            <Button x:Name="ClearBodyButton" Margin="4,0" Padding="8,2" Click="ClearBody_Click"/>
            <CheckBox x:Name="Base64Box" Margin="8,0,0,0" VerticalAlignment="Center"
                      Checked="BodyFormat_Changed" Unchecked="BodyFormat_Changed"/>
          </StackPanel>
          <Label x:Name="BodyLabel" Target="{Binding ElementName=BodyBox}"/>
        </DockPanel>
        <Grid Grid.Row="7">
          <TextBox x:Name="BodyBox" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="BodyBox_TextChanged"
                   AutomationProperties.LabeledBy="{Binding ElementName=BodyLabel}"/>
          <TextBlock x:Name="BodyFileText" Margin="4" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Grid>
        <!-- The options that Raw mode never uses are disabled there, each with the reason in its tooltip. -->
        <WrapPanel Grid.Row="8" Margin="0,8,0,0" Orientation="Horizontal">
          <CheckBox x:Name="FollowRedirectsBox" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                    Checked="FollowRedirects_Changed" Unchecked="FollowRedirects_Changed"/>
          <ComboBox x:Name="RedirectLimitBox" MinWidth="56" Margin="6,0,0,0" VerticalAlignment="Center" IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True"/>
          <CheckBox x:Name="InspectSessionBox" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </WrapPanel>
        <WrapPanel Grid.Row="9" Margin="0,6,0,0" Orientation="Horizontal">
          <Label x:Name="HttpVersionLabel" Padding="0,0,6,0" VerticalAlignment="Center"
                 Target="{Binding ElementName=HttpVersionBox}"/>
          <ComboBox x:Name="HttpVersionBox" MinWidth="130" VerticalAlignment="Center" SelectionChanged="HttpVersion_Changed"
                    ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.LabeledBy="{Binding ElementName=HttpVersionLabel}"/>
          <CheckBox x:Name="ConnectToBox" Margin="18,0,0,0" VerticalAlignment="Center"
                    Checked="ConnectTo_Changed" Unchecked="ConnectTo_Changed"/>
          <TextBox x:Name="ConnectToText" MinWidth="190" Margin="6,0,0,0" VerticalContentAlignment="Center"
                   IsEnabled="False"/>
          <CheckBox x:Name="ProxyBox" Margin="18,0,0,0" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                    Checked="Proxy_Changed" Unchecked="Proxy_Changed"/>
          <TextBox x:Name="ProxyText" MinWidth="190" Margin="6,0,0,0" VerticalContentAlignment="Center"
                   IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
          <!-- The list of client certificates is read only when it is opened (ListCertificatesAsync). -->
          <CheckBox x:Name="ClientCertificateBox" Margin="18,0,0,0" VerticalAlignment="Center"
                    ToolTipService.ShowOnDisabled="True"
                    Checked="ClientCertificate_Changed" Unchecked="ClientCertificate_Changed"/>
          <ComboBox x:Name="ClientCertificateList" MinWidth="220" MaxWidth="480" Margin="6,0,0,0" VerticalAlignment="Center"
                    IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                    DropDownOpened="ClientCertificateList_DropDownOpened"/>
          <CheckBox x:Name="WindowsAuthBox" Margin="18,0,0,0" VerticalAlignment="Center"
                    ToolTipService.ShowOnDisabled="True"
                    Checked="WindowsAuth_Changed" Unchecked="WindowsAuth_Changed"/>
        </WrapPanel>
      </Grid>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" ResizeDirection="Columns"/>
      <local:RequestResponseView x:Name="ResponseView" Grid.Column="2"/>
    </Grid>
    <!-- Copy as cURL and Save as cURL script export the full request, credentials and body included: the warning beside
         them says so before either is used. -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <Button x:Name="CopyCurlButton" DockPanel.Dock="Left" MinWidth="140" Margin="4" Padding="8,4" Click="CopyCurl_Click"
              ToolTipService.ShowOnDisabled="True"/>
      <Button x:Name="SaveCurlButton" DockPanel.Dock="Left" MinWidth="140" Margin="4" Padding="8,4" Click="SaveCurl_Click"
              ToolTipService.ShowOnDisabled="True"/>
      <TextBlock x:Name="CurlWarningText" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"/>
    <DockPanel Grid.Row="5" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button x:Name="OpenRequestButton" MinWidth="110" Margin="4" Padding="8,4" Click="OpenRequest_Click"/>
        <Button x:Name="SaveRequestButton" MinWidth="110" Margin="4" Padding="8,4" Click="SaveRequest_Click"
                ToolTipService.ShowOnDisabled="True"/>
        <!-- History lists the requests that the Replays tab recorded, from the history as it is when the menu opens, and
             keeps them current only while it is open; closing it keeps nothing of them. -->
        <Button x:Name="HistoryButton" MinWidth="90" Margin="4" Padding="8,4" Click="History_Click">
          <Button.ContextMenu>
            <ContextMenu x:Name="HistoryMenu" Placement="Top" Opened="HistoryMenu_Opened" Closed="HistoryMenu_Closed"/>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="SendButton" MinWidth="90" Margin="4" Padding="8,4" Click="Send_Click"/>
        <Button x:Name="CancelSendButton" MinWidth="110" Margin="4" Padding="8,4" IsEnabled="False" Click="CancelSend_Click"/>
        <Button x:Name="CloseButton" MinWidth="90" Margin="4" Padding="8,4" IsCancel="True" Click="Close_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
