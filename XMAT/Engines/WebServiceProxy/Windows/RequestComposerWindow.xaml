<Window x:Class="XMAT.WebServiceCapture.RequestComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMAT.WebServiceCapture"
        xmlns:app="clr-namespace:XMAT"
        Title="Edit and resend" Width="1120" Height="760" MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Background="{DynamicResource SurfacePanelBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <!-- The new look lays the window out on the 4 px spacing grid (Styles/Spacing.xaml): 16 around the content, 12 between
       groups, 8 between controls in a row, 4 between a label and its field and between option rows, buttons 28 tall,
       and the window's own buttons in a footer under a divider. Each property that differs takes the original look's own
       value with app:Look, so the original look is unchanged. -->
  <Window.Resources>
    <!-- The new look's notice: what matters most on one line, then Details, which shows the whole notice under it in
         secondary text. Details is a toggle button, so Tab reaches it and Space or Enter opens it; keyboard focus outlines
         its text, as on the host lists' disclosures. -->
    <Style x:Key="NoticeDisclosureStyle" TargetType="Expander">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <WrapPanel x:Name="SummaryRow">
                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap"
                           Margin="{DynamicResource InlineGap}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ToggleButton x:Name="HeaderSite" FocusVisualStyle="{x:Null}"
                              Content="{x:Static local:RequestComposerWindow.NoticeDetailsToggleText}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid>
                          <Border x:Name="FocusRing" Margin="-3,-1" BorderThickness="1" Visibility="Collapsed"
                                  CornerRadius="{DynamicResource InputCornerRadius}"
                                  BorderBrush="{DynamicResource TextPrimaryBrush}"/>
                          <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <Path x:Name="Chevron" Width="{DynamicResource SpaceM}" Height="{DynamicResource SpaceM}"
                              Margin="4,0,0,0" VerticalAlignment="Center" Data="M2.5,4.5 L6,8 L9.5,4.5"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.25"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="Data" Value="M2.5,7.5 L6,4 L9.5,7.5"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
              </WrapPanel>
              <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="SummaryRow" Property="Margin" Value="{DynamicResource HeadingDescriptionGap}"/>
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="{app:Look New=0, Original=12}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- The whole notice, which the original look shows here and the new look shows under Details (NoticeDetails), with
         its summary (NoticeDetails.Header) on the line above. -->
    <TextBlock x:Name="ReplayNotice" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="{app:Look New=Collapsed, Original=Visible}"/>
    <Expander x:Name="NoticeDetails" Margin="16,16,16,12" Style="{StaticResource NoticeDisclosureStyle}"
              Visibility="{app:Look New=Visible, Original=Collapsed}">
      <TextBlock x:Name="NoticeDetailsText" Text="{Binding Text, ElementName=ReplayNotice}" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Expander>
    <!-- The parts that a request file left out, until each is supplied with its button; typing never supplies one. -->
    <Border x:Name="OmissionsPanel" Grid.Row="1" Margin="{app:Look New='16,0,16,12', Original='0,0,0,10'}"
            Padding="{app:Look New=12, Original=8}" BorderThickness="1"
            BorderBrush="{DynamicResource BorderSubtleBrush}" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="OmissionsText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Margin="{app:Look New='0,8,0,0', Original='0,6,0,0'}" Orientation="Horizontal">
          <Button x:Name="CompleteMethodButton" Margin="0,0,8,0" Padding="{app:Look New='12,5', Original='8,2'}" Click="CompletePart_Click"/>
          <Button x:Name="CompleteUrlButton" Margin="0,0,8,0" Padding="{app:Look New='12,5', Original='8,2'}" Click="CompletePart_Click"/>
          <Button x:Name="CompleteHeadersButton" Margin="0,0,8,0" Padding="{app:Look New='12,5', Original='8,2'}" Click="CompletePart_Click"/>
          <Button x:Name="CompleteNoHeadersButton" Margin="0,0,8,0" Padding="{app:Look New='12,5', Original='8,2'}" Click="CompletePart_Click"/>
          <Button x:Name="CompleteBodyButton" Margin="0,0,8,0" Padding="{app:Look New='12,5', Original='8,2'}" Click="CompletePart_Click"/>
          <Button x:Name="CompleteEmptyBodyButton" Margin="0,0,8,0" Padding="{app:Look New='12,5', Original='8,2'}" Click="CompletePart_Click"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- Raw mode's warning, shown whenever Raw mode is, in the place of the parts left out, which Raw mode never has. -->
    <Border x:Name="RawWarningPanel" Grid.Row="1" Margin="{app:Look New='16,0,16,12', Original='0,0,0,10'}"
            Padding="{app:Look New=12, Original=8}" BorderThickness="1"
            BorderBrush="{DynamicResource BorderSubtleBrush}" Visibility="Collapsed">
      <TextBlock x:Name="RawWarningText" TextWrapping="Wrap"/>
    </Border>
    <Grid Grid.Row="2" Margin="{app:Look New='16,0', Original=0}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="{app:Look New=24, Original=8}"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid x:Name="RequestEditor">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="3*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Switches between Parsed and Raw mode, first in the editor's Tab order; it converts and asks before any loss. -->
        <Button x:Name="ModeButton" HorizontalAlignment="Left" Margin="{app:Look New='0,0,0,8', Original='0,0,0,6'}"
                Padding="{app:Look New='12,5', Original='8,2'}" Click="ModeButton_Click"/>
        <Grid Grid.Row="1" Grid.RowSpan="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- The new look's labels have no inset, so their text lines up with their fields' edges, 4 above them. -->
          <Label x:Name="MethodLabel" Padding="{app:Look New='0,0,0,4', Original=5}" Target="{Binding ElementName=MethodBox}"/>
          <Label x:Name="UrlLabel" Grid.Column="1" Padding="{app:Look New='0,0,0,4', Original=5}"
                 Target="{Binding ElementName=UrlBox}"/>
          <TextBox x:Name="MethodBox" Grid.Row="1" Margin="{app:Look New='0,0,8,0', Original='0,0,6,0'}" VerticalContentAlignment="Center"
                   AutomationProperties.LabeledBy="{Binding ElementName=MethodLabel}"/>
          <TextBox x:Name="UrlBox" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
                   TextChanged="UrlBox_TextChanged" AutomationProperties.LabeledBy="{Binding ElementName=UrlLabel}"/>
          <!-- Raw mode's target origin takes the method's and the URL's place; the URL keeps its text for Parsed mode. -->
          <Label x:Name="RawTargetLabel" Grid.ColumnSpan="2" Padding="{app:Look New='0,0,0,4', Original=5}"
                 Target="{Binding ElementName=RawTargetBox}" Visibility="Collapsed"/>
          <TextBox x:Name="RawTargetBox" Grid.Row="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                   Visibility="Collapsed" AutomationProperties.LabeledBy="{Binding ElementName=RawTargetLabel}"/>
        </Grid>
        <Label x:Name="HeadersLabel" Grid.Row="3" Margin="{app:Look New='0,12,0,0', Original=0}"
               Padding="{app:Look New='0,0,0,4', Original=5}" Target="{Binding ElementName=HeadersBox}"/>
        <Label x:Name="RawHeadLabel" Grid.Row="3" Margin="{app:Look New='0,12,0,0', Original=0}"
               Padding="{app:Look New='0,0,0,4', Original=5}" Target="{Binding ElementName=RawHeadBox}" Visibility="Collapsed"/>
        <TextBox x:Name="HeadersBox" Grid.Row="4" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.LabeledBy="{Binding ElementName=HeadersLabel}"/>
        <!-- Raw mode's head: the request line and header lines, which keep tabs, never wrap, and are counted below. -->
        <TextBox x:Name="RawHeadBox" Grid.Row="4" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed" TextChanged="RawHeadBox_TextChanged"
                 AutomationProperties.LabeledBy="{Binding ElementName=RawHeadLabel}"/>
        <!-- Not live: typing is not announced; refusals go to the status, which is. -->
        <TextBlock x:Name="RawCountsText" Grid.Row="5" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <DockPanel Grid.Row="6" Margin="{app:Look New='0,12,0,4', Original='0,6,0,0'}">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UploadFileButton" Margin="{app:Look New='8,0,0,0', Original='4,0'}"
                    Padding="{app:Look New='12,5', Original='8,2'}" Click="UploadFile_Click"/>
            <Button x:Name="BuildFormButton" Margin="{app:Look New='8,0,0,0', Original='4,0'}"
                    Padding="{app:Look New='12,5', Original='8,2'}" Click="BuildForm_Click"
                    ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="FixContentLengthButton" Margin="{app:Look New='8,0,0,0', Original='4,0'}"
                    Padding="{app:Look New='12,5', Original='8,2'}" Visibility="Collapsed"
                    Click="FixContentLength_Click"/>
            <Button x:Name="ClearBodyButton" Margin="{app:Look New='8,0,0,0', Original='4,0'}"
                    Padding="{app:Look New='12,5', Original='8,2'}" Click="ClearBody_Click"/>
            <CheckBox x:Name="Base64Box" Margin="{app:Look New='16,0,0,0', Original='8,0,0,0'}" VerticalAlignment="Center"
                      Checked="BodyFormat_Changed" Unchecked="BodyFormat_Changed"/>
          </StackPanel>
          <Label x:Name="BodyLabel" Padding="{app:Look New=0, Original=5}"
                 VerticalContentAlignment="{app:Look New=Center, Original=Top}" Target="{Binding ElementName=BodyBox}"/>
        </DockPanel>
        <Grid Grid.Row="7">
          <TextBox x:Name="BodyBox" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="BodyBox_TextChanged"
                   AutomationProperties.LabeledBy="{Binding ElementName=BodyLabel}"/>
          <TextBlock x:Name="BodyFileText" Margin="4" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Grid>
        <!-- The options that Raw mode never uses are disabled there, each with the reason in its tooltip. In the new look,
             the connection options are a form: their labels share the left edge and their fields one column. -->
        <WrapPanel Grid.Row="8" Margin="{app:Look New='0,12,0,0', Original='0,8,0,0'}" Orientation="Horizontal">
          <CheckBox x:Name="FollowRedirectsBox" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                    Checked="FollowRedirects_Changed" Unchecked="FollowRedirects_Changed"/>
          <ComboBox x:Name="RedirectLimitBox" MinWidth="56" Margin="{app:Look New='8,0,0,0', Original='6,0,0,0'}"
                    VerticalAlignment="Center" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
          <CheckBox x:Name="InspectSessionBox" Margin="{app:Look New='24,0,0,0', Original='18,0,0,0'}" VerticalAlignment="Center"/>
        </WrapPanel>
        <app:FormWrapPanel Grid.Row="9" Margin="{app:Look New='0,4,0,0', Original='0,6,0,0'}" Orientation="Horizontal">
          <Label x:Name="HttpVersionLabel" Padding="{app:Look New=0, Original='0,0,6,0'}" VerticalAlignment="Center"
                 Target="{Binding ElementName=HttpVersionBox}"/>
          <ComboBox x:Name="HttpVersionBox" app:FormWrapPanel.IsField="True" MinWidth="130" VerticalAlignment="Center"
                    SelectionChanged="HttpVersion_Changed" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.LabeledBy="{Binding ElementName=HttpVersionLabel}"/>
          <CheckBox x:Name="ConnectToBox" Margin="{app:Look New=0, Original='18,0,0,0'}" VerticalAlignment="Center"
                    Checked="ConnectTo_Changed" Unchecked="ConnectTo_Changed"/>
          <TextBox x:Name="ConnectToText" app:FormWrapPanel.IsField="True" MinWidth="190"
                   Margin="{app:Look New=0, Original='6,0,0,0'}" VerticalContentAlignment="Center" IsEnabled="False"/>
          <CheckBox x:Name="ProxyBox" Margin="{app:Look New=0, Original='18,0,0,0'}" VerticalAlignment="Center"
                    ToolTipService.ShowOnDisabled="True" Checked="Proxy_Changed" Unchecked="Proxy_Changed"/>
          <TextBox x:Name="ProxyText" app:FormWrapPanel.IsField="True" MinWidth="190"
                   Margin="{app:Look New=0, Original='6,0,0,0'}" VerticalContentAlignment="Center"
                   IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
          <!-- The list of client certificates is read only when it is opened (ListCertificatesAsync). -->
          <CheckBox x:Name="ClientCertificateBox" Margin="{app:Look New=0, Original='18,0,0,0'}" VerticalAlignment="Center"
                    ToolTipService.ShowOnDisabled="True"
                    Checked="ClientCertificate_Changed" Unchecked="ClientCertificate_Changed"/>
          <ComboBox x:Name="ClientCertificateList" app:FormWrapPanel.IsField="True" MinWidth="220" MaxWidth="480"
                    Margin="{app:Look New=0, Original='6,0,0,0'}" VerticalAlignment="Center"
                    IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                    DropDownOpened="ClientCertificateList_DropDownOpened"/>
          <CheckBox x:Name="WindowsAuthBox" Margin="{app:Look New=0, Original='18,0,0,0'}" VerticalAlignment="Center"
                    ToolTipService.ShowOnDisabled="True"
                    Checked="WindowsAuth_Changed" Unchecked="WindowsAuth_Changed"/>
        </app:FormWrapPanel>
      </Grid>
      <GridSplitter Grid.Column="1" Width="{app:Look New=12, Original=4}" HorizontalAlignment="Center" ResizeDirection="Columns"/>
      <!-- 4 lower in the new look, so its 20 px heading lines up with the middle of the 28 px mode button beside it. -->
      <local:RequestResponseView x:Name="ResponseView" Grid.Column="2" Margin="{app:Look New='0,4,0,0', Original=0}"/>
    </Grid>
    <!-- Copy as cURL and Save as cURL script export the full request, credentials and body included: the warning beside
         them says so before either is used. -->
    <DockPanel Grid.Row="3" Margin="{app:Look New='16,12,16,0', Original='0,8,0,0'}">
      <Button x:Name="CopyCurlButton" DockPanel.Dock="Left" MinWidth="{app:Look New=88, Original=140}"
              Margin="{app:Look New='0,0,8,0', Original=4}" Padding="{app:Look New='12,5', Original='8,4'}" Click="CopyCurl_Click"
              ToolTipService.ShowOnDisabled="True"/>
      <Button x:Name="SaveCurlButton" DockPanel.Dock="Left" MinWidth="{app:Look New=88, Original=140}"
              Margin="{app:Look New='0,0,8,0', Original=4}" Padding="{app:Look New='12,5', Original='8,4'}" Click="SaveCurl_Click"
              ToolTipService.ShowOnDisabled="True"/>
      <TextBlock x:Name="CurlWarningText" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="{app:Look New='16,8,16,0', Original='0,10'}" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"/>
    <!-- The window's own buttons. The new look puts them in a footer, under a divider across the window. -->
    <Border Grid.Row="5" Margin="{app:Look New='0,12,0,0', Original=0}" Padding="{app:Look New=16, Original=0}"
            BorderThickness="{app:Look New='0,1,0,0', Original=0}" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="OpenRequestButton" MinWidth="{app:Look New=88, Original=110}" Margin="{app:Look New='0,0,8,0', Original=4}"
                  Padding="{app:Look New='12,5', Original='8,4'}" Click="OpenRequest_Click"/>
          <Button x:Name="SaveRequestButton" MinWidth="{app:Look New=88, Original=110}" Margin="{app:Look New='0,0,8,0', Original=4}"
                  Padding="{app:Look New='12,5', Original='8,4'}" Click="SaveRequest_Click" ToolTipService.ShowOnDisabled="True"/>
          <!-- History lists the requests that the Replays tab recorded, from the history as it is when the menu opens, and
               keeps them current only while it is open; closing it keeps nothing of them. -->
          <Button x:Name="HistoryButton" MinWidth="{app:Look New=88, Original=90}" Margin="{app:Look New='0,0,8,0', Original=4}"
                  Padding="{app:Look New='12,5', Original='8,4'}" Click="History_Click">
            <Button.ContextMenu>
              <ContextMenu x:Name="HistoryMenu" Placement="Top" Opened="HistoryMenu_Opened" Closed="HistoryMenu_Closed"/>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SendButton" MinWidth="{app:Look New=88, Original=90}" Margin="{app:Look New='8,0,0,0', Original=4}"
                  Padding="{app:Look New='12,5', Original='8,4'}" Click="Send_Click"/>
          <Button x:Name="CancelSendButton" MinWidth="{app:Look New=88, Original=110}" Margin="{app:Look New='8,0,0,0', Original=4}"
                  Padding="{app:Look New='12,5', Original='8,4'}" IsEnabled="False" Click="CancelSend_Click"/>
          <Button x:Name="CloseButton" MinWidth="{app:Look New=88, Original=90}" Margin="{app:Look New='8,0,0,0', Original=4}"
                  Padding="{app:Look New='12,5', Original='8,4'}" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
