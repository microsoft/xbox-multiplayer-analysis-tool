<Window x:Class="XMAT.WebServiceCapture.MultipartFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build form" Width="720" Height="660" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}">
  <!-- Builds a multipart/form-data body for the composer's request from text and file parts, in order
       (MultipartFormWindow.xaml.cs). The Tab order is the order below: the parts, a new part, then the form. -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="MethodText" TextWrapping="Wrap"/>
      <TextBlock x:Name="MethodHintText" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock x:Name="IntroText" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,10,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Label x:Name="PartsLabel" Grid.ColumnSpan="2" Padding="0,0,0,4" Target="{Binding ElementName=PartsList}"/>
      <ListBox x:Name="PartsList" Grid.Row="1" MinHeight="80" SelectionChanged="PartsList_SelectionChanged"
               AutomationProperties.LabeledBy="{Binding ElementName=PartsLabel}"/>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
        <Button x:Name="RemovePartButton" MinWidth="100" Margin="0,0,0,4" Padding="8,2" Click="RemovePart_Click"/>
        <Button x:Name="MoveUpButton" MinWidth="100" Margin="0,0,0,4" Padding="8,2" Click="MoveUp_Click"/>
        <Button x:Name="MoveDownButton" MinWidth="100" Padding="8,2" Click="MoveDown_Click"/>
      </StackPanel>
    </Grid>
    <!-- A new part: its name and, optionally, its type, then its value for a text part, or a file to pick. Only the name
         and the type are checked as they are typed; a value is measured only when a file is picked or the form is used,
         never on the UI thread. -->
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="120"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Label x:Name="NameLabel" Padding="0,0,8,0" VerticalAlignment="Center" Target="{Binding ElementName=NameBox}"/>
      <TextBox x:Name="NameBox" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="Field_TextChanged"
               AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>
      <TextBlock x:Name="NameReason" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" TextWrapping="Wrap"
                 Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <Label x:Name="TypeLabel" Grid.Row="2" Margin="0,6,0,0" Padding="0,0,8,0" VerticalAlignment="Center"
             Target="{Binding ElementName=TypeBox}"/>
      <TextBox x:Name="TypeBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" VerticalContentAlignment="Center"
               TextChanged="Field_TextChanged" AutomationProperties.LabeledBy="{Binding ElementName=TypeLabel}"/>
      <TextBlock x:Name="TypeReason" Grid.Row="3" Grid.Column="1" Margin="0,2,0,0" TextWrapping="Wrap"
                 Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <Label x:Name="ValueLabel" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,6,0,0" Padding="0,0,0,4"
             Target="{Binding ElementName=ValueBox}"/>
      <TextBox x:Name="ValueBox" Grid.Row="5" Grid.ColumnSpan="2" FontFamily="Consolas" AcceptsReturn="True"
               AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
               AutomationProperties.LabeledBy="{Binding ElementName=ValueLabel}"/>
      <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6,0,0" Orientation="Horizontal">
        <Button x:Name="AddTextButton" MinWidth="110" Margin="0,0,8,0" Padding="8,2" Click="AddText_Click"/>
        <Button x:Name="AddFileButton" MinWidth="110" Padding="8,2" Click="AddFile_Click"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"/>
    <!-- Close is the Cancel button: Esc closes the dialog, which stops a pick or Use form in progress and changes nothing. -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="UseFormButton" MinWidth="90" Margin="4" Padding="8,4" Click="UseForm_Click"/>
      <Button x:Name="CancelWorkButton" MinWidth="90" Margin="4" Padding="8,4" IsEnabled="False" Click="CancelWork_Click"/>
      <Button x:Name="CloseButton" MinWidth="90" Margin="4" Padding="8,4" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
