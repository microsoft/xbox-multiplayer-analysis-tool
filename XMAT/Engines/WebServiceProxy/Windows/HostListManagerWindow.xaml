<Window x:Class="XMAT.WebServiceCapture.HostListManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMAT.WebServiceCapture"
        Width="720" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
    <TabControl Grid.Row="1">
      <TabItem x:Name="BlockTab">
        <local:BlockListView x:Name="BlockListEditor" ShowScopeNote="False"/>
      </TabItem>
      <TabItem x:Name="BypassTab">
        <local:BypassListView x:Name="BypassListEditor" ShowScopeNote="False"/>
      </TabItem>
    </TabControl>
    <Button x:Name="CloseButton" Grid.Row="2" HorizontalAlignment="Right" MinWidth="90"
            Margin="0,8,0,0" Padding="6" IsCancel="True" Click="Close_Click"/>
  </Grid>
</Window>
