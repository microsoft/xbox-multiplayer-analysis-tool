<Window x:Class="XMAT.WebServiceCapture.HostListManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMAT.WebServiceCapture"
        xmlns:app="clr-namespace:XMAT"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Width="720" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="{app:Look New=True, Original=False}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontSize="{DynamicResource BaseFontSize}">
  <!-- The new look snaps the window's layout to whole pixels, as the main window does, so its hairlines stay sharp. -->
  <Window.Resources>
    <!-- The window's sizes, on the 4 px grid -->
    <sys:Double x:Key="CloseButtonMinWidth">88</sys:Double>
    <Thickness x:Key="ActionButtonPadding">12,4</Thickness>

    <!-- The new look shows the window on the panel surface, where the lists' wells stand out as they do in a capture's
         tabs. -->
    <Style x:Key="SurfaceStyle" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsNewLook, Source={x:Static app:LookState.Current}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The intro and the tabs, 24 px from the window's edges in the new look. -->
    <Style x:Key="ContentStyle" TargetType="Grid">
      <Setter Property="Margin" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsNewLook, Source={x:Static app:LookState.Current}}" Value="True">
          <Setter Property="Margin" Value="{DynamicResource DialogInset}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A fact about both lists: a bullet in a 12 px column, with secondary text that wraps beside it. Facts are 4 px
         apart. -->
    <Style x:Key="FactStyle" TargetType="DockPanel">
      <Setter Property="Margin" Value="{DynamicResource BulletGap}"/>
    </Style>
    <Style x:Key="FactTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="{DynamicResource TextLineHeight}"/>
    </Style>
    <Style x:Key="FactBulletStyle" TargetType="TextBlock" BasedOn="{StaticResource FactTextStyle}">
      <Setter Property="DockPanel.Dock" Value="Left"/>
      <Setter Property="Text" Value="&#x2022;"/>
      <Setter Property="Width" Value="{DynamicResource BulletIndent}"/>
    </Style>

    <!-- In the new look, Close sits in a footer below a hairline, 16 px above and below it, and lines up with the right
         edge of the content. It is as tall as the app's other controls. -->
    <Style x:Key="FooterStyle" TargetType="Border">
      <Setter Property="Padding" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsNewLook, Source={x:Static app:LookState.Current}}" Value="True">
          <Setter Property="Padding" Value="{DynamicResource DialogFooterInset}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseHostStyle" TargetType="Border">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsNewLook, Source={x:Static app:LookState.Current}}" Value="True">
          <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <!-- The original look has one margin around everything; in the new look the content and the footer set their own. -->
  <Grid Margin="{app:Look New=0, Original=12}" Style="{StaticResource SurfaceStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Style="{StaticResource ContentStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                 Visibility="{app:Look New=Collapsed, Original=Visible}"/>
      <!-- The new look states the scope in a lead sentence, then lists what applies to both lists, 16 px above the
           tabs. Each list's description then keeps only what the list does. -->
      <StackPanel x:Name="IntroPanel" Margin="{DynamicResource GroupGap}"
                  Visibility="{app:Look New=Visible, Original=Collapsed}">
        <TextBlock x:Name="IntroLeadText" FontSize="{DynamicResource DialogTextFontSize}" TextWrapping="Wrap"
                   LineHeight="{DynamicResource TextLineHeight}" Margin="{DynamicResource HeadingContentGap}"/>
        <DockPanel Style="{StaticResource FactStyle}">
          <TextBlock Style="{StaticResource FactBulletStyle}"/>
          <TextBlock x:Name="ChangesFactText" Style="{StaticResource FactTextStyle}"/>
        </DockPanel>
        <DockPanel Style="{StaticResource FactStyle}">
          <TextBlock Style="{StaticResource FactBulletStyle}"/>
          <TextBlock x:Name="BlockFactText" Style="{StaticResource FactTextStyle}"/>
        </DockPanel>
        <DockPanel>
          <TextBlock Style="{StaticResource FactBulletStyle}"/>
          <TextBlock x:Name="ExitFactText" Style="{StaticResource FactTextStyle}"/>
        </DockPanel>
      </StackPanel>
      <!-- The new look's tabs are the inspector's: labels with an accent underline. Each list starts 16 px below them and
           keeps the window's 24 px edges, with no padding of its own. -->
      <TabControl x:Name="ListTabs" Grid.Row="1" Style="{DynamicResource InspectorTabControlStyle}">
        <TabControl.Resources>
          <Thickness x:Key="InspectorContentPadding">0,16,0,0</Thickness>
          <Thickness x:Key="PanelInset">0</Thickness>
        </TabControl.Resources>
        <TabItem x:Name="BlockTab" Style="{DynamicResource InspectorTabItemStyle}">
          <local:BlockListView x:Name="BlockListEditor" ShowScopeNote="False"/>
        </TabItem>
        <TabItem x:Name="BypassTab" Style="{DynamicResource InspectorTabItemStyle}">
          <local:BypassListView x:Name="BypassListEditor" ShowScopeNote="False"/>
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{app:Look New='0,1,0,0', Original=0}"
            Style="{StaticResource FooterStyle}">
      <Border Style="{StaticResource CloseHostStyle}">
        <Button x:Name="CloseButton" MinWidth="{app:Look New={StaticResource CloseButtonMinWidth}, Original=90}"
                Padding="{app:Look New={StaticResource ActionButtonPadding}, Original=6}"
                Margin="{app:Look New=0, Original='0,8,0,0'}" IsCancel="True" Click="Close_Click"/>
      </Border>
    </Border>
  </Grid>
</Window>
