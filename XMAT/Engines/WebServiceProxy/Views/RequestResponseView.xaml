<UserControl x:Class="XMAT.WebServiceCapture.RequestResponseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XMAT.WebServiceCapture"
             xmlns:app="clr-namespace:XMAT"
             mc:Ignorable="d"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Background="{DynamicResource SurfacePanelBrush}">
        <!-- The title's details sit at its right when they fit, and wrap below it when the pane is narrow. -->
        <app:ReflowPanel DockPanel.Dock="Top" Margin="{DynamicResource HeadingBottomSpacing}"
                         Spacing="{app:Look New=16, Original=0}" StackedSpacing="2">
            <TextBlock Style="{DynamicResource SectionTitleStyle}" MinHeight="{app:Look New=20, Original=24}"
                       Padding="{app:Look New='0', Original='10,0,0,0'}"
                       VerticalAlignment="Center" Text="{Binding Title, FallbackValue=Request}"/>
            <ContentPresenter Content="{Binding HeaderContent}" VerticalAlignment="Center"
                              HorizontalAlignment="Right" app:ReflowPanel.Weight="1"
                              app:ReflowPanel.StackedAlignment="Left"/>
        </app:ReflowPanel>
        <TabControl x:Name="RequestTabs" Style="{DynamicResource FormatTabControlStyle}">
            <TabItem x:Name="HeadersTab" Header="Headers" Style="{DynamicResource FormatTabItemStyle}">
                <ContentControl Style="{DynamicResource RecessedSurfaceStyle}">
                    <ScrollViewer>
                        <TextBox Style="{DynamicResource InspectorTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" ScrollViewer.CanContentScroll="True" Text="{Binding FirstLineAndHeaders, Mode=OneWay}"/>
                    </ScrollViewer>
                </ContentControl>
            </TabItem>
            <!-- The Body and JSON tabs show one preview of the body, made in the background (RequestResponseView.xaml.cs);
                 what it says about the body (empty, not kept, cut, shown as bytes) is in a message bar, apart from the body. -->
            <TabItem x:Name="BodyTab" Header="Body" Style="{DynamicResource FormatTabItemStyle}">
                <ContentControl Style="{DynamicResource RecessedSurfaceStyle}">
                    <DockPanel>
                        <TextBlock x:Name="BodyMessage" DockPanel.Dock="Top" Margin="4,2" TextWrapping="Wrap" FontStyle="Italic"
                                   Visibility="Collapsed"/>
                        <TextBox x:Name="BodyTextBox" Style="{DynamicResource InspectorTextBoxStyle}" IsReadOnly="True"
                                 TextWrapping="NoWrap" FontFamily="Consolas"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </ContentControl>
            </TabItem>
            <TabItem x:Name="JsonTab" Header="JSON" Style="{DynamicResource FormatTabItemStyle}">
                <ContentControl Style="{DynamicResource RecessedSurfaceStyle}">
                    <DockPanel>
                        <TextBlock x:Name="JsonMessage" DockPanel.Dock="Top" Margin="4,2" TextWrapping="Wrap" FontStyle="Italic"
                                   Visibility="Collapsed"/>
                        <TreeView x:Name="JsonTree" Style="{DynamicResource InspectorTreeViewStyle}"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate
                                    DataType="{x:Type local:JsonTreeViewItem}"
                                    ItemsSource="{Binding JsonTreeViewItems}">
                                    <TextBlock Text="{Binding PropertyDescriptor}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsExpanded" Value="{Binding AutoExpandJson}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </ContentControl>
            </TabItem>
            <!--<TabItem Header="Image">
                    <Image Source="{Binding BodyBytes, Mode=OneWay}" Stretch="Uniform"/>
            </TabItem>-->
        </TabControl>
    </DockPanel>
</UserControl>
