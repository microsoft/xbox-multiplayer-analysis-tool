<UserControl x:Class="XMAT.WebServiceCapture.WebSocketMessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XMAT.WebServiceCapture"
             xmlns:app="clr-namespace:XMAT"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <local:JsonConverter x:Key="JsonConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{app:Look New=Auto, Original=30}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Each filter keeps its label; the second filter moves to a new line when the pane is narrow. -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource SurfacePanelBrush}"
                   Margin="{app:Look New='0,0,0,8', Original='0'}">
            <StackPanel Orientation="Horizontal" Margin="{app:Look New='0,0,16,0', Original='0'}">
                <TextBlock x:Name="DirectionLabel" Text="Direction" Style="{DynamicResource FilterLabelStyle}"
                           Margin="{app:Look New='0,0,8,0', Original='8,0,4,0'}"/>
                <ComboBox x:Name="DirectionFilter" Width="130" Margin="{app:Look New='0,2', Original='0,3,12,3'}"
                          AutomationProperties.LabeledBy="{Binding ElementName=DirectionLabel}"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Client → Server"/>
                    <ComboBoxItem Content="Server → Client"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TypeLabel" Text="Type" Style="{DynamicResource FilterLabelStyle}"
                           Margin="{app:Look New='0,0,8,0', Original='0,0,4,0'}"/>
                <ComboBox x:Name="MessageTypeFilter" Width="90" Margin="{app:Look New='0,2', Original='0,3,0,3'}"
                          AutomationProperties.LabeledBy="{Binding ElementName=TypeLabel}"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Text"/>
                    <ComboBoxItem Content="Binary"/>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <!-- The new look stacks the messages above the selected message, so both stay readable in a narrow pane;
             the original look keeps them side by side. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="{app:Look New=2*, Original=*}"/>
                <RowDefinition Height="{app:Look New=12, Original=0}"/>
                <RowDefinition Height="{app:Look New=3*, Original=0}"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{app:Look New=*, Original=2*}"/>
                <ColumnDefinition Width="{app:Look New=0, Original=4}"/>
                <ColumnDefinition Width="{app:Look New=0, Original=3*}"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="MessagesGrid" Grid.Row="0" Grid.Column="0"
                      ItemsSource="{Binding ItemsSource, ElementName=Root}"
                      SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      SelectionMode="Single"
                      ColumnHeaderStyle="{DynamicResource MessageGridHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="95"/>
                    <DataGridTextColumn Header="#" Binding="{Binding RequestNumber}" Width="45"/>
                    <DataGridTextColumn Header="CONNECTION" Binding="{Binding ConnectionID}" Width="85"/>
                    <DataGridTextColumn Header="DIRECTION" Binding="{Binding Direction}" Width="120"/>
                    <DataGridTextColumn Header="TYPE" Binding="{Binding MessageType}" Width="65"/>
                    <DataGridTextColumn Header="BYTES" Binding="{Binding PayloadLength}" Width="55"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter x:Name="MessagesSplitter" Grid.Row="{app:Look New=1, Original=0}" Grid.Column="{app:Look New=0, Original=1}"
                          Width="{app:Look New=Auto, Original=4}" Height="{app:Look New=12, Original=Auto}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="{app:Look New=Rows, Original=Columns}"/>

            <Grid Grid.Row="{app:Look New=2, Original=0}" Grid.Column="{app:Look New=0, Original=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PayloadNotice" Grid.Row="0" Style="{DynamicResource NoticeTextStyle}"
                           Text="{Binding SelectedItem.PayloadNotice, ElementName=MessagesGrid}"
                           Foreground="{DynamicResource WarningTextBrush}"
                           Margin="{app:Look New='0,0,0,8', Original='6'}"/>
                <TabControl Grid.Row="1" Style="{DynamicResource FormatTabControlStyle}">
                    <TabItem Header="Text" Style="{DynamicResource FormatTabItemStyle}">
                        <ContentControl Style="{DynamicResource RecessedSurfaceStyle}">
                            <TextBox Style="{DynamicResource InspectorTextBoxStyle}"
                                     Text="{Binding SelectedItem.PayloadText, ElementName=MessagesGrid, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="JSON" Style="{DynamicResource FormatTabItemStyle}">
                        <ContentControl Style="{DynamicResource RecessedSurfaceStyle}">
                            <TreeView x:Name="MessageJsonTree" Style="{DynamicResource InspectorTreeViewStyle}"
                                      ItemsSource="{Binding SelectedItem.PayloadText, ElementName=MessagesGrid, Converter={StaticResource JsonConverter}}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:JsonTreeViewItem}"
                                                              ItemsSource="{Binding JsonTreeViewItems}">
                                        <TextBlock Text="{Binding PropertyDescriptor}"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding AutoExpandJson}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="Hex" Style="{DynamicResource FormatTabItemStyle}">
                        <ContentControl Style="{DynamicResource RecessedSurfaceStyle}">
                            <TextBox Style="{DynamicResource InspectorTextBoxStyle}"
                                     Text="{Binding SelectedItem.PayloadHex, ElementName=MessagesGrid, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto"/>
                        </ContentControl>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
