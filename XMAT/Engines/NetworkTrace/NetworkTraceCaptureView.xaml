<UserControl x:Class="NetworkTraceCaptureControls.NetworkTraceCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetworkTraceCaptureControls"
             xmlns:app="clr-namespace:XMAT"
             xmlns:logic="clr-namespace:XMAT.NetworkTrace"
             xmlns:model="clr-namespace:XMAT.NetworkTrace.Models"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             x:Name="NetworkTraceCaptureControl"
             FocusManager.FocusedElement="{Binding ElementName=PacketList}"
             d:DesignHeight="450" d:DesignWidth="1200">
    <UserControl.Resources>
        <logic:NetworkPayloadConverter x:Key="NetworkPayloadConverter"/>
        <logic:PacketFlagsConverter x:Key="PacketFlagsConverter"/>
        <logic:NetworkProtocolConverter x:Key="NetworkProtocolConverter"/>
        <logic:DeviceStatusConverter x:Key="DeviceStatusConverter"/>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static logic:NetworkTraceCommands.StartStopCapture}" Executed="StartStopCapture_Executed" CanExecute="StartStopCapture_CanExecute"/>
    </UserControl.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{app:Look New=Auto, Original=30}" MinHeight="30"/>
            <RowDefinition Height="{app:Look New=Auto, Original=30}" MinHeight="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="{app:Look New=12, Original=4}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tab continues past the toolbar's last button instead of cycling inside the toolbar. In the new look the
             toolbar stays in the packets' column: spanning the packet data's star column from its Auto row would make
             the Grid measure the packet table at infinite height, which builds a row for every packet. -->
        <ToolBar Grid.Row="0" Grid.ColumnSpan="{app:Look New=1, Original=2}" ToolBarTray.IsLocked="True"
                 KeyboardNavigation.TabNavigation="Continue">
            <!-- The new look shares the web proxy capture's green start action; the original look keeps its toggle. -->
            <app:ActionToggleButton x:Name="StartStopButton" Style="{DynamicResource NetworkTraceStartStopButtonStyle}"
                                    IsChecked="{Binding CaptureController.IsRunning, Mode=OneWay}" CommandTarget="{Binding ElementName=NetworkTraceCaptureControl}" Command="{x:Static logic:NetworkTraceCommands.StartStopCapture}" CommandParameter="{Binding IsChecked,RelativeSource={RelativeSource Self}}"/>
            <app:RecordingIndicator x:Name="CapturingIndicator" Style="{DynamicResource RecordingIndicatorStyle}"
                                    IsActive="{Binding CaptureController.IsRunning, Mode=OneWay}"/>
            <Separator/>
            <Button x:Name="AnalyzeCaptureButton"
                    Command="{x:Static app:AppCommands.AnalyzeCaptures}"
                    CommandTarget="{Binding ElementName=NetworkTraceCaptureControl}"
                    IsEnabled="{Binding CaptureController.HaveTraces}"
                    ToolTipService.ShowOnDisabled="True">Analyze Capture</Button>
            <Separator/>
            <Button x:Name="ClearCapturesButton" Command="{x:Static app:AppCommands.ClearAllCaptures}" CommandTarget="{Binding ElementName=NetworkTraceCaptureControl}" IsEnabled="{Binding CaptureController.HaveTraces}">Clear Captures</Button>
        </ToolBar>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{DynamicResource SurfacePanelBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FiltersText" Style="{DynamicResource FilterLabelStyle}" Margin="{app:Look New='0,0,12,0', Original='20,0'}" Text="Filters"/>
                <app:CheckBoxFilters x:Name="PidFilters" FilterDesc="PID" FiltersChanged="OnFiltersChanged" ItemsSource="{Binding CaptureController.PidFilterList}"/>
                <app:CheckBoxFilters x:Name="TidFilters" FilterDesc="TID" FiltersChanged="OnFiltersChanged" ItemsSource="{Binding CaptureController.TidFilterList}"/>
                <app:CheckBoxFilters x:Name="ProtocolFilters" FilterDesc="PROTO" FiltersChanged="OnFiltersChanged" ItemsSource="{Binding CaptureController.ProtocolFilterList}"/>
                <app:CheckBoxFilters x:Name="SourceIpFilters" FilterDesc="SRCIP" FiltersChanged="OnFiltersChanged" ItemsSource="{Binding CaptureController.SourceIpFilterList}"/>
                <app:CheckBoxFilters x:Name="DestIpFilters" FilterDesc="DESTIP" FiltersChanged="OnFiltersChanged" ItemsSource="{Binding CaptureController.DestIpFilterList}"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Grid.RowSpan="3" FontSize="{DynamicResource EmptyStateFontSize}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding CaptureController.HaveNoTraces, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Text="{Binding CaptureController.DeviceStatus, Mode=OneWay, Converter={StaticResource DeviceStatusConverter}}"/>
        <DataGrid x:Name="PacketList" Grid.Row="2" Grid.RowSpan="3" ColumnHeaderStyle="{DynamicResource PacketGridHeaderStyle}"
                  IsSynchronizedWithCurrentItem="True" IsReadOnly="True"
                  Visibility="{Binding CaptureController.HaveTraces, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ItemsSource="{Binding NetworkTracePackets, ElementName=NetworkTraceCaptureControl, Mode=OneWay}"
                  AutoGenerateColumns="False" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fffffff}}" Width="120"/>
                <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol, Mode=OneWay, Converter={StaticResource NetworkProtocolConverter}}" Width="62"/>
                <DataGridTextColumn Header="S" Binding="{Binding Flags, Mode=OneWay, Converter={StaticResource PacketFlagsConverter},ConverterParameter={x:Static model:NetworkPacketFlags.StartOfPacket}}" Width="22"/>
                <DataGridTextColumn Header="E" Binding="{Binding Flags, Mode=OneWay, Converter={StaticResource PacketFlagsConverter},ConverterParameter={x:Static model:NetworkPacketFlags.EndOfPacket}}" Width="22"/>
                <DataGridTextColumn Header="F" Binding="{Binding Flags, Mode=OneWay, Converter={StaticResource PacketFlagsConverter},ConverterParameter={x:Static model:NetworkPacketFlags.Fragment}}" Width="22"/>
                <DataGridTextColumn Header="Tx" Binding="{Binding Flags, Mode=OneWay, Converter={StaticResource PacketFlagsConverter},ConverterParameter={x:Static model:NetworkPacketFlags.Send}}" Width="22"/>
                <DataGridTextColumn Header="Rx" Binding="{Binding Flags, Mode=OneWay, Converter={StaticResource PacketFlagsConverter},ConverterParameter={x:Static model:NetworkPacketFlags.Receive}}" Width="22"/>
                <DataGridTextColumn Header="LEN" Binding="{Binding Payload.Length}" Width="40"/>
                <DataGridTextColumn Header="SRC IP" Binding="{Binding SourceIpv4Address}" Width="100"/>
                <DataGridTextColumn Header="DEST IP" Binding="{Binding DestinationIpv4Address}" Width="100"/>
                <DataGridTextColumn Header="SRC MAC" Binding="{Binding SourceMacAddress}" Width="110"/>
                <DataGridTextColumn Header="DEST MAC" Binding="{Binding DestinationMacAddress}" Width="110"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding MediaType}" Width="80"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="40"/>
                <DataGridTextColumn Header="TID" Binding="{Binding ThreadId}" Width="40"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- The new look's quiet divider between the packets and their data, as between the traffic and the inspector. -->
        <GridSplitter x:Name="PacketSplitter" Grid.Row="{app:Look New=1, Original=2}" Grid.Column="1" Grid.RowSpan="{app:Look New=2, Original=63}" Width="{app:Look New=12, Original=4}"
                      Style="{DynamicResource ColumnSplitterStyle}" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

        <TabControl x:Name="PacketEvent" Grid.Row="{app:Look New=1, Original=0}" Grid.RowSpan="{app:Look New=2, Original=3}" Grid.Column="2">
            <TabItem x:Name="PacketRawTextTab" Header="Packet Data">
                <!-- A read-only text box, so the keyboard can reach, scroll and select the packet data. It draws like
                     the text it replaced. -->
                <TextBox x:Name="PayloadRawText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Padding="0" Background="Transparent"
                         Text="{Binding SelectedItem, ElementName=PacketList, Mode=OneWay, Converter={StaticResource NetworkPayloadConverter}}"/>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
