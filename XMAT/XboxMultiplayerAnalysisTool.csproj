<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseWPF>true</UseWPF>
    <StartupObject>XMAT.Program</StartupObject>
    <AssemblyName>XboxMultiplayerAnalysisTool</AssemblyName>
    <Platforms>x64</Platforms>
    <ApplicationIcon>XMAT.ico</ApplicationIcon>
    <Copyright>©Microsoft Corporation. All rights reserved.</Copyright>
    <Company>Microsoft Corporation</Company>
    <Authors>Microsoft Corporation</Authors>
    <Description>Xbox Multiplayer Analysis Tool</Description>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Version>0.2</Version>
    <Deterministic>true</Deterministic>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableTelemetry Condition="'$(EnableTelemetry)' == ''">false</EnableTelemetry>
    <TelemetryApproved Condition="'$(TelemetryApproved)' == ''">false</TelemetryApproved>
    <TelemetryBuildChannel Condition="'$(TelemetryBuildChannel)' == ''">Local</TelemetryBuildChannel>
    <BuildTelemetrySdk Condition="'$(BuildTelemetrySdk)' == ''">false</BuildTelemetrySdk>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningLevel>3</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildTelemetrySdk)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);XMAT_TELEMETRY_SDK</DefineConstants>
    <ApplicationManifest>telemetry.manifest</ApplicationManifest>
    <CsWinRTIncludes>Microsoft.Xbox.Telemetry</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ViewModels\**" />
    <EmbeddedResource Remove="ViewModels\**" />
    <None Remove="ViewModels\**" />
    <Page Remove="ViewModels\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\XboxLiveTraceAnalyzer.APIMap.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\XboxLiveTraceAnalyzer.Rules.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Resource Include="Resources\html\xlta\*.html" />
    <Resource Include="Resources\html\xlta\*.css" />
    <Resource Include="Resources\html\xlta\*.js" />
  </ItemGroup>
  
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonDocumentPath" Version="1.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.12.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildTelemetrySdk)' == 'true'">
    <PackageReference Include="Microsoft.Xbox.Telemetry" Version="0.8.0.261118001" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.VCRTForwarders.140" Version="1.0.7" GeneratePathProperty="true" ExcludeAssets="all" />
    <CsWinRTInputs Include="$(PkgMicrosoft_Xbox_Telemetry)\build\native\lib\x64\Microsoft.Xbox.Telemetry.winmd" />
    <Content Include="$(PkgMicrosoft_Xbox_Telemetry)\build\native\lib\x64\Microsoft.Xbox.Telemetry.dll"
             Link="Microsoft.Xbox.Telemetry.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Xbox_Telemetry)\build\native\lib\x64\Microsoft.Xbox.Telemetry.pri"
             Link="Microsoft.Xbox.Telemetry.pri" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_VCRTForwarders_140)\runtimes\win10-x64\native\release\*.dll"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Xmat.Telemetry.Enabled" Value="$(EnableTelemetry)" />
    <AssemblyMetadata Include="Xmat.Telemetry.Approved" Value="$(TelemetryApproved)" />
    <AssemblyMetadata Include="Xmat.Telemetry.Channel" Value="$(TelemetryBuildChannel)" />
    <AssemblyMetadata Include="Xmat.Telemetry.Key" Value="$(TelemetryInstrumentationKey)" Condition="'$(EnableTelemetry)' == 'true'" />
  </ItemGroup>

  <Target Name="ValidateTelemetryConfiguration" BeforeTargets="GenerateAssemblyInfo">
    <Error Condition="'$(EnableTelemetry)' != 'true' and '$(EnableTelemetry)' != 'false'" Text="EnableTelemetry must be true or false." />
    <Error Condition="'$(EnableTelemetry)' == 'true' and '$(TelemetryApproved)' != 'true'" Text="Telemetry-enabled builds require TelemetryApproved=true." />
    <Error Condition="'$(BuildTelemetrySdk)' != 'true' and '$(BuildTelemetrySdk)' != 'false'" Text="BuildTelemetrySdk must be true or false." />
    <Error Condition="'$(EnableTelemetry)' == 'true' and '$(BuildTelemetrySdk)' != 'true'" Text="Telemetry-enabled builds require BuildTelemetrySdk=true." />
    <Error Condition="'$(EnableTelemetry)' == 'true' and '$(TelemetryBuildChannel)' != 'Public' and '$(TelemetryBuildChannel)' != 'Internal' and '$(TelemetryBuildChannel)' != 'Test'" Text="Telemetry-enabled builds require TelemetryBuildChannel=Public, Internal, or Test." />
    <Error Condition="'$(EnableTelemetry)' == 'true' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(TelemetryInstrumentationKey)', '^(?=.{1,128}$)(?=.*-)[A-Za-z0-9-]+$'))" Text="Telemetry-enabled builds require a valid TelemetryInstrumentationKey." />
  </Target>

  <ItemGroup>
    <Page Update="Engines\NetworkTrace\NetworkTraceCaptureView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\WebServiceProxy\Views\CaptureConnectionView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\WebServiceProxy\Views\BlockListView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\WebServiceProxy\Views\CaptureControlView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\WebServiceProxy\Views\CaptureErrorView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\WebServiceProxy\Views\CaptureOptionsFull.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\WebServiceProxy\Views\CaptureTimelineView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\WebServiceProxy\Views\CaptureToolStrip.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Controls\CheckBoxFilters.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Controls\ScriptEditorView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\AnalysisReportsView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\AnalysisResultsView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\CallsReportView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\CertWarningsReportView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\Controls\PerEndpointDetails.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\Controls\PerEndpointRuleDetail.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\Controls\RuleViolationDetail.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\PerEndpointReportView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\RuleDataViews\BatchFrequencyRuleDataView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\RuleDataViews\BurstDetectionRuleDataView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\RuleDataViews\CallFrequencyRuleDataView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\RuleDataViews\PollingDetectionRuleDataView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\RuleDataViews\RepeatedCallsRuleDataView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\RuleDataViews\SmallBatchDetectionRuleDataView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\RuleDataViews\ThrottledCallRuleDataView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Engines\CaptureAnalysis\ReportViews\StatsReportView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
  </ItemGroup>

    <ItemGroup>
      <None Update="Langs\en-us.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="logo.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="XMAT.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
