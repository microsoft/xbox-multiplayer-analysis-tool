<!-- The traffic overview above the capture timeline (Controls/TrafficOverview.xaml), as designed in G11 "Traffic overview
     while capturing": a 56px well in the text area color; 11px labels, a 16px total and a 12px rate; a 140x28 line of
     requests per second; a 180x8 status bar in the timeline's status colors over a legend of counts; and the three busiest
     hosts with 60px bars. Every color is a theme brush, so Light, Dark and High Contrast apply. Only the new look merges
     this dictionary; the original look has no overview. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:XMAT">

    <!-- Type sizes, which the Windows Text size setting scales with the look's other sizes (TextScale). -->
    <sys:Double x:Key="TrafficOverviewLabelFontSize">11</sys:Double>
    <sys:Double x:Key="TrafficOverviewTotalFontSize">16</sys:Double>

    <!-- Inset like the filters above it and the timeline below it: 4px below the filters, 8px above the timeline, or
         tighter with Comfort view off (TrafficOverviewMargin in App.xaml and Looks/DenseSpacing.xaml). Hidden, its Show
         overview button takes a slim row. -->
    <Style TargetType="local:TrafficOverview">
        <Setter Property="Margin" Value="{DynamicResource TrafficOverviewMargin}"/>
        <Style.Triggers>
            <Trigger Property="IsExpanded" Value="False">
                <Setter Property="Margin" Value="{DynamicResource TrafficOverviewHiddenMargin}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TrafficOverviewStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TextAreaBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="MinHeight" Value="56"/>
    </Style>

    <!-- The cells sit 12px from the sides and 5px from the top and bottom; the busiest hosts keep clear of the hide
         button in the corner. -->
    <Style x:Key="TrafficOverviewCellsStyle" TargetType="local:TrafficOverviewPanel">
        <Setter Property="Margin" Value="12,5"/>
        <Setter Property="HostsReserve" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Labels: Requests, Status, Busiest hosts. -->
    <Style x:Key="TrafficOverviewLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TrafficOverviewLabelFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="TrafficOverviewHostsLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TrafficOverviewLabelStyle}">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="48"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- The label row of the requests: Requests at the left, the rate at the right, 2px above the count. -->
    <Style x:Key="TrafficOverviewLabelRowStyle" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="False"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="TrafficOverviewRateStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

    <Style x:Key="TrafficOverviewTotalStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TrafficOverviewTotalFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="TrafficOverviewSparklineStyle" TargetType="local:TrafficSparkline">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="LineBrush" Value="{DynamicResource TabSelectionIndicatorBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="TrafficOverviewDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}"/>
    </Style>

    <!-- The status bar, 4px below its label and above its legend. Its tooltip opens 23px below it, 4px under the legend
         (19px). -->
    <Style x:Key="TrafficOverviewStatusBarStyle" TargetType="local:TrafficStatusBar">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="ToolTipOffset" Value="23"/>
        <Setter Property="SuccessBrush" Value="{DynamicResource TimelineBarSuccessBrush}"/>
        <Setter Property="RedirectBrush" Value="{DynamicResource TimelineBarRedirectBrush}"/>
        <Setter Property="ClientErrorBrush" Value="{DynamicResource TimelineBarClientErrorBrush}"/>
        <Setter Property="ServerErrorBrush" Value="{DynamicResource TimelineBarServerErrorBrush}"/>
        <Setter Property="NoStatusBrush" Value="{DynamicResource TimelineBarNoStatusBrush}"/>
        <Setter Property="TrackBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
        <Setter Property="OutlineBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <!-- Parts show a keyboard focus outline just outside them. -->
    <Style x:Key="TrafficOverviewFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2,-1" BorderThickness="1" CornerRadius="2"
                            BorderBrush="{DynamicResource PrimaryForegroundBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legend items are 6px apart; the legend gives the last item's gap back. -->
    <Style x:Key="TrafficOverviewLegendStyle" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,0,-6,0"/>
    </Style>

    <!-- A legend item: the class's color, its name and its count, such as "4xx 63". -->
    <Style x:Key="TrafficOverviewLegendItemStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="{DynamicResource TrafficOverviewLabelFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource TrafficOverviewFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Hover" Margin="-2,0" CornerRadius="2"/>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Swatch" Width="8" Height="8" CornerRadius="2" Margin="0,0,4,0"
                                    VerticalAlignment="Center" Background="{DynamicResource TimelineBarSuccessBrush}"/>
                            <TextBlock Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"><Run
                                Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource SecondaryForegroundBrush}"/><Run
                                Text=" "/><Run Text="{Binding CountText, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                        <Border x:Name="HoverOutline" Margin="-2,0" CornerRadius="2" BorderThickness="1"
                                BorderBrush="{DynamicResource HoverOutlineBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding StatusClass}" Value="Redirect">
                            <Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TimelineBarRedirectBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusClass}" Value="ClientError">
                            <Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TimelineBarClientErrorBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusClass}" Value="ServerError">
                            <Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TimelineBarServerErrorBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusClass}" Value="None">
                            <Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TimelineBarNoStatusBrush}"/>
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Focusable" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            <Setter TargetName="HoverOutline" Property="Visibility" Value="Visible"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The status as text: 12px, centered in the 28px row below its label. -->
    <Style x:Key="TrafficOverviewStatusTextStyle" TargetType="ItemsControl">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ItemsPresenter VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrafficOverviewTextSeparatorStyle" TargetType="TextBlock">
        <Setter Property="Text" Value=" · "/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TrafficOverviewTextItemStyle" TargetType="ContentControl">
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource TrafficOverviewFocusVisualStyle}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Hover" Margin="-2,0" CornerRadius="2"/>
                        <TextBlock Foreground="{TemplateBinding Foreground}"><Run
                            Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource SecondaryForegroundBrush}"/><Run
                            Text=" "/><Run Text="{Binding CountText, Mode=OneWay}"/></TextBlock>
                        <Border x:Name="HoverOutline" Margin="-2,0" CornerRadius="2" BorderThickness="1"
                                BorderBrush="{DynamicResource HoverOutlineBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Focusable" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            <Setter TargetName="HoverOutline" Property="Visibility" Value="Visible"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A busiest host: its name, a 4px bar against the busiest host and its count, in columns the three rows share. -->
    <Style x:Key="TrafficOverviewHostItemStyle" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource TrafficOverviewLabelFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource TrafficOverviewFocusVisualStyle}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrafficOverviewHostName"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrafficOverviewHostCount"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Hover" Grid.ColumnSpan="5" Margin="-2,0" CornerRadius="2"/>
                        <TextBlock Text="{Binding Label}" Foreground="{TemplateBinding Foreground}" MaxWidth="120"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Width="60" Height="4" CornerRadius="1" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Background="{DynamicResource ColumnHeaderDividerBrush}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Share}"/>
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock Grid.Column="4" Text="{Binding CountText}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <Border x:Name="HoverOutline" Grid.ColumnSpan="5" Margin="-2,0" CornerRadius="2" BorderThickness="1"
                                BorderBrush="{DynamicResource HoverOutlineBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            <Setter TargetName="HoverOutline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The chevron in the top right corner that hides the overview. -->
    <Style x:Key="TrafficOverviewHideButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,4,4,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource TrafficOverviewFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"/>
                        <Path Data="M0.5,4.5 L4.5,0.5 L8.5,4.5" Width="9" Height="5" Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="HoverOutline" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1"
                                BorderBrush="{DynamicResource HoverOutlineBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            <Setter TargetName="HoverOutline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- While the overview is hidden: Show overview and a chevron, at the right where the hide button was. -->
    <Style x:Key="TrafficOverviewShowButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="{DynamicResource TrafficOverviewLabelFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource TrafficOverviewFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <Path Data="M0.5,0.5 L4.5,4.5 L8.5,0.5" Width="9" Height="5" Margin="6,1,0,0"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HoverOutline" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1"
                                BorderBrush="{DynamicResource HoverOutlineBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            <Setter TargetName="HoverOutline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The parts' tooltips, such as "4xx: 63 requests (5%). Select to filter.", are the app's tooltips (App.xaml). -->
</ResourceDictionary>
