<!-- How a state's meaning shows (Logic/StatusMeanings.cs): a problem in red with a cross, something that needs attention
     in amber with a warning sign, and everything routine without color. The icons are shapes, so they take the theme's
     colors, a contrast theme's included, and the words or the code beside them say the same without color
     (docs/design-system.md). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:XMAT">

    <!-- A problem: a filled circle with a cross cut out of it, on a 12px square. -->
    <CombinedGeometry x:Key="ProblemIconGeometry" GeometryCombineMode="Exclude">
        <CombinedGeometry.Geometry1>
            <EllipseGeometry Center="6,6" RadiusX="6" RadiusY="6"/>
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2>
            <GeometryGroup FillRule="Nonzero">
                <RectangleGeometry Rect="2.75,5.25,6.5,1.5">
                    <RectangleGeometry.Transform>
                        <RotateTransform Angle="45" CenterX="6" CenterY="6"/>
                    </RectangleGeometry.Transform>
                </RectangleGeometry>
                <RectangleGeometry Rect="2.75,5.25,6.5,1.5">
                    <RectangleGeometry.Transform>
                        <RotateTransform Angle="-45" CenterX="6" CenterY="6"/>
                    </RectangleGeometry.Transform>
                </RectangleGeometry>
            </GeometryGroup>
        </CombinedGeometry.Geometry2>
    </CombinedGeometry>

    <!-- Something that needs attention: a filled triangle with an exclamation mark cut out of it, on a 12px square. -->
    <CombinedGeometry x:Key="AttentionIconGeometry" GeometryCombineMode="Exclude">
        <CombinedGeometry.Geometry1>
            <PathGeometry Figures="M 6,0.5 L 11.75,11.25 L 0.25,11.25 Z"/>
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2>
            <GeometryGroup>
                <RectangleGeometry Rect="5.25,3.75,1.5,4.25" RadiusX="0.5" RadiusY="0.5"/>
                <EllipseGeometry Center="6,9.6" RadiusX="0.85" RadiusY="0.85"/>
            </GeometryGroup>
        </CombinedGeometry.Geometry2>
    </CombinedGeometry>

    <!-- An HTTP status in a table cell. A problem's or a warning's code takes its color, after its icon, and any other
         code the row's text color (STATUS-2). Every row keeps the icon's space, so the codes line up (STATUS-4). The
         code is set as a text column sets its text, so it sits in its cell as the row's other values do. -->
    <Style TargetType="local:StatusText">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:StatusText">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="Icon" Width="12" Height="12" Margin="2,0,2,0" VerticalAlignment="Center"
                              Stretch="Uniform" Visibility="Hidden"/>
                        <TextBlock x:Name="Code" Text="{TemplateBinding Status}"
                                   Style="{x:Static DataGridTextColumn.DefaultElementStyle}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- A response still streaming is work under way: the word, in secondary text, instead of the
                             code, which shows when the response ends. -->
                        <Trigger Property="Meaning" Value="Working">
                            <Setter TargetName="Code" Property="Text" Value="{x:Static local:StatusText.StreamingText}"/>
                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Meaning" Value="Attention">
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource AttentionIconGeometry}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource WarningTextBrush}"/>
                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                        </Trigger>
                        <Trigger Property="Meaning" Value="Problem">
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource ProblemIconGeometry}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ErrorTextBrush}"/>
                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
