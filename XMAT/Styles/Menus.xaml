<!-- Menus in the new look: the surface that context menus, the More menu and the main menu's dropdowns share, and the
     group headers and notes that context menus are labeled with. App.xaml merges it, and its MenuItem style lays out the
     rows. The original look keeps its own menus. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:XMAT">

    <!-- Keyboard focus outlines the highlighted row. -->
    <Style x:Key="MenuItemFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource TextPrimaryBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The surface: 8px corners, a 1px border and 4px of padding, 220 to 320px wide, on a soft shadow (MenuShadow). The
         margin leaves 24px at the sides, 16px above and 32px below for the shadow; popups place the surface itself, not
         its margin, where a menu opens. App.xaml's MenuItem template gives dropdowns and submenus the same surface. -->
    <Style x:Key="ContextMenuSurfaceStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceCanvasBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Margin" Value="24,16,24,32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid>
                        <local:MenuShadow Background="{TemplateBinding Background}" CornerRadius="8"/>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8" MinWidth="220" MaxWidth="320"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Background="Transparent" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group's header, 28px tall: the group's name in semibold and, 6px after it, the subject its items act on, which
         ends in an ellipsis rather than widening the menu past its width. Menus pass over it with the arrow keys. -->
    <Style TargetType="local:MenuGroupHeader">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MenuGroupHeader">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Text}" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock x:Name="Subject" Grid.Column="1" Margin="6,0,0,0" Text="{TemplateBinding Subject}"
                                       TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subject" Value="{x:Null}">
                            <Setter TargetName="Subject" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A note, 28px tall for one line: secondary text with a 12px info icon in the rows' icon lane. A longer note
         wraps, so it never widens the menu. Menus pass over it with the arrow keys. -->
    <Style TargetType="local:MenuNote">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MenuNote">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- The icon sits on the first line, which is 16px tall. -->
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" TextWrapping="Wrap"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
