<!-- Choice cards in the new look: one option of a choice shown as a card, with a picture, a title and a sentence about
     it, such as New Capture's devices and capture types (Controls/ChoiceCard.cs). The chosen card takes the selected
     fill, a 2px accent outline, an accent picture and a check. A card that isn't available sits dimmed on the well
     color, its note saying why. The pictures are in Styles/CaptureIcons.xaml. Looks/NewLook.xaml merges this
     dictionary. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:XMAT">

    <!-- Keyboard focus: a 2px ring in the text color, 2px outside the card. Focus that comes from a click shows none. -->
    <Style x:Key="ChoiceCardFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" CornerRadius="8" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource TextPrimaryBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The picture is above the text, or beside it with Orientation="Horizontal". A card with a note keeps its
         description in the text color, so the note, in the secondary color, reads as the detail; without one, the
         description is secondary. Content shows 8px under the text while the card is chosen. -->
    <Style TargetType="local:ChoiceCard">
        <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ChoiceCardFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ChoiceCard">
                    <Grid>
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Path x:Name="Picture" Width="40" Height="40" VerticalAlignment="Top"
                                      Data="{TemplateBinding Icon}" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <StackPanel x:Name="Text" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold"
                                               LineHeight="{DynamicResource TextLineHeight}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="DescriptionText" Margin="0,4,0,0" Text="{TemplateBinding Description}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Grid x:Name="NoteRow" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <!-- The icon sits on the note's first line. -->
                                        <Path x:Name="NotePicture" Width="14" Height="14" Margin="0,1,6,1"
                                              VerticalAlignment="Top" Data="{TemplateBinding NoteIcon}"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.25"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <TextBlock x:Name="NoteText" Grid.Column="1" Text="{TemplateBinding Note}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <ContentPresenter x:Name="Extra" Margin="0,8,0,0" Visibility="Collapsed"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- With the card's border, a 2px outline that draws inward, so the content doesn't move. -->
                        <Border x:Name="SelectedEdge" Margin="1" BorderThickness="1" CornerRadius="3"
                                BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                        <Border x:Name="HoverOutline" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderBrush="{DynamicResource HoverOutlineBrush}" Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                        <!-- The check: 12px in from the top right corner, inside the border. -->
                        <Grid x:Name="Check" Width="18" Height="18" Margin="0,13,13,0" HorizontalAlignment="Right"
                              VerticalAlignment="Top" Visibility="Collapsed">
                            <Ellipse Fill="{DynamicResource AccentFillBrush}"/>
                            <Path Data="M5.2,9.2 L7.7,11.6 L12.8,6.5" Stroke="{DynamicResource AccentOnFillBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Beside the picture, the text keeps clear of the check. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="Text" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="Text" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="Text" Property="Grid.ColumnSpan" Value="1"/>
                            <Setter TargetName="Text" Property="Margin" Value="12,0,20,0"/>
                        </Trigger>
                        <Trigger Property="Note" Value="{x:Null}">
                            <Setter TargetName="NoteRow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DescriptionText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Note" Value="">
                            <Setter TargetName="NoteRow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DescriptionText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="NoteIcon" Value="{x:Null}">
                            <Setter TargetName="NotePicture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                            <Setter TargetName="HoverOutline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="SelectedEdge" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Picture" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="HasContent" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Extra" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <!-- Not available: the note, which says why, stays readable. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceWellBrush}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                            <Setter TargetName="Picture" Property="Stroke" Value="{DynamicResource TextDisabledBrush}"/>
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            <Setter TargetName="DescriptionText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
