//
// The destination owner must define XmatTelemetry using the approved ingestion mapping.
// Required columns:
// Timestamp:datetime, EventName:string, SessionId:string, DeviceId:string,
// AppVersion:string, BuildChannel:string, Feature:string, Operation:string,
// Outcome:string, DurationMs:long, Count:long, Stage:string, CaptureOrigin:string.
// EventName is the short event name; DeviceId maps the permitted ext.device.localId.
// These are dashboard templates, not ingestion/retention configuration.

// Eligible launches by release; keep test and internal channels out of public metrics.
XmatTelemetry
| where BuildChannel == "Public" and EventName == "AppLaunched"
| summarize Launches = count(), ActiveMachines = dcountif(DeviceId, isnotempty(DeviceId)),
    MissingMachineId = countif(isempty(DeviceId)) by bin(Timestamp, 1d), AppVersion;

// Attribute feature use to the session's launch day, including sessions spanning midnight.
let launchSessions = XmatTelemetry
    | where BuildChannel == "Public" and EventName == "AppLaunched"
    | summarize LaunchTime = min(Timestamp) by SessionId, AppVersion
    | extend Day = bin(LaunchTime, 1d);
let launches = launchSessions
    | summarize Sessions = dcount(SessionId) by Day, AppVersion;
XmatTelemetry
| where BuildChannel == "Public" and EventName == "FeatureUsed"
| join kind=inner launchSessions on SessionId, AppVersion
| summarize FeatureSessions = dcount(SessionId) by Day, AppVersion, Feature
| join kind=inner launches on Day, AppVersion
| extend AdoptionPercent = 100.0 * FeatureSessions / Sessions
| project Day, AppVersion, Feature, FeatureSessions, Sessions, AdoptionPercent;

// Operation outcomes and real completion latency, excluding dialog-cancellation counters.
XmatTelemetry
| where BuildChannel == "Public" and EventName == "OperationCompleted"
| summarize Attempts = count(), Succeeded = countif(Outcome == "Succeeded"),
    Failed = countif(Outcome == "Failed"), NoData = countif(Outcome == "NoData"),
    Cancelled = countif(Outcome == "Cancelled"), Unsupported = countif(Outcome == "Unsupported"),
    P50Ms = percentile(DurationMs, 50), P95Ms = percentile(DurationMs, 95)
    by AppVersion, Operation, CaptureOrigin;

// Session-level live-capture and imported-data funnels use the actual analysis origin.
// A mixed session contributes to both only when it analyzed both origins.
XmatTelemetry
| where BuildChannel == "Public"
| summarize Launched = countif(EventName == "AppLaunched"),
    DeviceAdded = countif(EventName == "OperationCompleted" and Operation == "DeviceAdd" and Outcome == "Succeeded"),
    CaptureWithData = countif(EventName == "CaptureFirstData"),
    Imported = countif(EventName == "OperationCompleted" and Operation == "ImportSaz" and Outcome == "Succeeded"),
    AnalyzedCapture = countif(EventName == "OperationCompleted" and Operation == "Analysis" and Outcome == "Succeeded"
        and CaptureOrigin in ("User", "Restored")),
    AnalyzedImport = countif(EventName == "OperationCompleted" and Operation == "Analysis" and Outcome == "Succeeded"
        and CaptureOrigin == "Imported"),
    ReportViewed = countif(EventName == "FeatureUsed" and Feature in ("PerEndpointReport", "StatisticsReport", "NetworkReport"))
    by SessionId, AppVersion
| summarize Sessions = count(), SetupSessions = countif(DeviceAdded > 0),
    CaptureSessions = countif(CaptureWithData > 0), ImportSessions = countif(Imported > 0),
    AnalyzedCaptureSessions = countif(CaptureWithData > 0 and AnalyzedCapture > 0),
    AnalyzedImportSessions = countif(Imported > 0 and AnalyzedImport > 0),
    ReportSessions = countif(ReportViewed > 0) by AppVersion;

// First-observed/returning machines are not people or installations.
let firstSeen = XmatTelemetry
    | where BuildChannel == "Public" and EventName == "AppLaunched" and isnotempty(DeviceId)
    | summarize FirstSeen = min(Timestamp) by DeviceId;
XmatTelemetry
| where BuildChannel == "Public" and EventName == "AppLaunched" and isnotempty(DeviceId)
| join kind=inner firstSeen on DeviceId
| summarize NewMachines = dcountif(DeviceId, startofday(Timestamp) == startofday(FirstSeen)),
    ReturningMachines = dcountif(DeviceId, startofday(Timestamp) > startofday(FirstSeen))
    by Day = bin(Timestamp, 1d);

// Machine retention within the available, approved dataset; do not display raw IDs.
let machineWeeks = XmatTelemetry
    | where BuildChannel == "Public" and EventName == "AppLaunched" and isnotempty(DeviceId)
    | summarize by DeviceId, Week = bin(Timestamp, 7d);
machineWeeks
| join kind=leftouter (machineWeeks | project DeviceId, NextWeek = Week - 7d) on DeviceId, $left.Week == $right.NextWeek
| summarize ActiveMachines = dcount(DeviceId), RetainedMachines = dcountif(DeviceId, isnotnull(NextWeek)) by Week
| extend RetentionPercent = 100.0 * RetainedMachines / ActiveMachines;

// Observed failure rate only; absent AppClosed events do not prove crashes.
XmatTelemetry
| where BuildChannel == "Public"
| summarize Launched = countif(EventName == "AppLaunched"),
    ObservedFailure = countif(EventName == "UnhandledFailure") by SessionId, AppVersion
| summarize LaunchedSessions = countif(Launched > 0),
    SessionsWithObservedFailure = countif(Launched > 0 and ObservedFailure > 0) by AppVersion;

// Rolling active machines and sessions per machine; query windows are not retention policy.
XmatTelemetry
| where BuildChannel == "Public" and EventName == "AppLaunched" and Timestamp >= ago(28d)
| summarize MonthlyActiveMachines = dcountif(DeviceId, isnotempty(DeviceId)),
    WeeklyActiveMachines = dcountif(DeviceId, isnotempty(DeviceId) and Timestamp >= ago(7d)),
    IdentifiedSessions = countif(isnotempty(DeviceId))
| extend SessionsPerMachine = todouble(IdentifiedSessions) / MonthlyActiveMachines;

// Network acquisition and analyzer stage timing are separate from overall capture duration.
XmatTelemetry
| where BuildChannel == "Public" and EventName == "OperationStage"
| summarize P50Ms = percentile(DurationMs, 50), P95Ms = percentile(DurationMs, 95)
    by AppVersion, Operation, Stage;
