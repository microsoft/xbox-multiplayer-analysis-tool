<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The new look's Light theme. Every color is a step of the palette that Palette.json generates from
         five base colors (docs/design-system.md). Views and styles use the roles; only this file and the High
         Contrast theme say which step or system color each role is. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Surfaces: window chrome, content panels, recessed wells, table headers, the capture tab strip, hover and buttons -->
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource Gray3}"/>
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="SurfaceWellBrush" Color="{StaticResource Gray2}"/>
    <SolidColorBrush x:Key="SurfaceHeaderBrush" Color="{StaticResource Gray3}"/>
    <SolidColorBrush x:Key="SurfaceStripBrush" Color="{StaticResource Gray5}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="SurfaceControlBrush" Color="{StaticResource Gray1}"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray13}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray10}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Gray9}"/>
    <SolidColorBrush x:Key="TextHeadingBrush" Color="{StaticResource Gray15}"/>
    <SolidColorBrush x:Key="TextControlBrush" Color="{StaticResource Gray13}"/>

    <!-- Borders: from the faintest grid line to the outline that identifies a control -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource Gray5}"/>
    <SolidColorBrush x:Key="BorderControlBrush" Color="{StaticResource Gray7}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Gray8}"/>
    <SolidColorBrush x:Key="BorderStrongHoverBrush" Color="{StaticResource Gray9}"/>
    <SolidColorBrush x:Key="BorderWellBrush" Color="{StaticResource Gray2}"/>

    <!-- Accent: selection, focus and the selected tab -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Blue8}"/>
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource Blue8}"/>
    <SolidColorBrush x:Key="AccentOnFillBrush" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource Blue3}"/>

    <!-- Status: each has a fill, the text on that fill, text on surfaces and a soft background -->
    <SolidColorBrush x:Key="SuccessFillBrush" Color="{StaticResource Green9}"/>
    <SolidColorBrush x:Key="SuccessOnFillBrush" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource Green10}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource Green2}"/>
    <SolidColorBrush x:Key="WarningFillBrush" Color="{StaticResource Amber9}"/>
    <SolidColorBrush x:Key="WarningOnFillBrush" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource Amber10}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource Amber1}"/>
    <SolidColorBrush x:Key="ErrorFillBrush" Color="{StaticResource Red8}"/>
    <SolidColorBrush x:Key="ErrorOnFillBrush" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource Red9}"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource Red2}"/>
    <SolidColorBrush x:Key="InfoFillBrush" Color="{StaticResource Blue9}"/>
    <SolidColorBrush x:Key="InfoOnFillBrush" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="NeutralFillBrush" Color="{StaticResource Gray9}"/>
    <SolidColorBrush x:Key="NeutralOnFillBrush" Color="{StaticResource Gray1}"/>

    <!-- Component colors: each belongs to one component, and High Contrast gives it a system color of its own. -->
    <SolidColorBrush x:Key="SkeletonBaseBrush" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="SkeletonHighlightBrush" Color="{StaticResource Gray2}"/>
    <SolidColorBrush x:Key="RecordingIndicatorBrush" Color="{StaticResource Red8}"/>
    <SolidColorBrush x:Key="CaptureActionBorderBrush" Color="{StaticResource Green11}"/>
    <SolidColorBrush x:Key="ColumnHeaderDividerBrush" Color="{StaticResource Gray7}"/>
    <SolidColorBrush x:Key="ExpanderHeaderBrush" Color="{StaticResource Gray7}"/>
    <SolidColorBrush x:Key="ExpanderSubHeaderBrush" Color="{StaticResource Gray6}"/>
    <SolidColorBrush x:Key="ExpanderDetailBrush" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="ColumnDividerBrush" Color="{StaticResource Gray5}" Opacity="0.3"/>
    <SolidColorBrush x:Key="HoverOutlineBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItemSelectedEdgeBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="CaptureActionSheenBrush" Color="#38FFFFFF"/>
    <!-- Inputs: a soft outline with a strong bottom edge. The brush is flipped, so it measures 1px up from the bottom. -->
    <LinearGradientBrush x:Key="InputBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="{StaticResource Gray8}"/>
        <GradientStop Offset="0.5" Color="{StaticResource Gray6}"/>
    </LinearGradientBrush>
    <!-- The capture start action: Xbox green (Green 9) with a soft vertical gradient. White text stays above 4.5:1. -->
    <LinearGradientBrush x:Key="CaptureActionBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Green8}"/>
        <GradientStop Offset="0.5" Color="{StaticResource Green9}"/>
        <GradientStop Offset="1" Color="{StaticResource Green10}"/>
    </LinearGradientBrush>
    <!-- Hover lightens the lower half by one step. -->
    <LinearGradientBrush x:Key="CaptureActionHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Green8}"/>
        <GradientStop Offset="0.5" Color="{StaticResource Green9}"/>
        <GradientStop Offset="1" Color="{StaticResource Green9}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CaptureActionPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Green10}"/>
        <GradientStop Offset="1" Color="{StaticResource Green11}"/>
    </LinearGradientBrush>
    <!-- Inactive capture tabs: a soft inner shadow at the base, like a tab sitting behind the selected one -->
    <LinearGradientBrush x:Key="TabItemInsetShadowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.6" Color="#00000000"/>
        <GradientStop Offset="0.8" Color="#03000000"/>
        <GradientStop Offset="0.9" Color="#06000000"/>
        <GradientStop Offset="1" Color="#0A000000"/>
    </LinearGradientBrush>

    <!-- Old names that views shared with the original look still use, each on its role's step. Remove them
         with the original look. -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource Gray3}"/>
    <SolidColorBrush x:Key="AltRowBackgroundBrush" Color="{StaticResource Gray2}"/>
    <SolidColorBrush x:Key="CapturePendingForegroundBrush" Color="{StaticResource Amber10}"/>

    <!-- Windows system colors, for built-in controls that XMAT doesn't restyle -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Gray3}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Blue2}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Gray13}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Blue2}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Gray13}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="{StaticResource Gray3}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource Gray9}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource Gray3}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource Blue7}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource Gray7}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="{StaticResource Gray9}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="{StaticResource Gray6}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="{StaticResource Gray2}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{StaticResource Amber1}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{StaticResource Gray16}"/>

</ResourceDictionary>
