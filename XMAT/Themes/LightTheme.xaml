<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / Panel backgrounds: the window is the chrome band; panels are one flat content surface -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"          Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"           Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AltRowBackgroundBrush"          Color="#FFF5F5F5"/>

    <!-- Foreground / text -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush"         Color="#FF333333"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush"       Color="#FF555555"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush"        Color="#FF767676"/>
    <SolidColorBrush x:Key="CapturePendingForegroundBrush"  Color="#FF8A4B00"/>
    <SolidColorBrush x:Key="CaptureErrorForegroundBrush"    Color="#FFC00000"/>
    <SolidColorBrush x:Key="WarningForegroundBrush"         Color="#FF8A5300"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"                    Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush"             Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="InteractiveBorderBrush"         Color="#FF707070"/>

    <!-- Selection -->
    <SolidColorBrush x:Key="InactiveSelectionBrush"         Color="LightBlue"/>
    <SolidColorBrush x:Key="ActiveSelectionBrush"           Color="#FF0078D4"/>
    <SolidColorBrush x:Key="ActiveSelectionForegroundBrush" Color="White"/>

    <!-- Expander / section backgrounds -->
    <SolidColorBrush x:Key="ExpanderHeaderBrush"            Color="#FFABABAB"/>
    <SolidColorBrush x:Key="ExpanderSubHeaderBrush"         Color="Silver"/>
    <SolidColorBrush x:Key="ExpanderDetailBrush"            Color="#FFE0E0E0"/>

    <!-- Menu / toolbar -->
    <SolidColorBrush x:Key="MenuBackgroundBrush"            Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="MenuForegroundBrush"            Color="#FF333333"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush"       Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush"       Color="#FF555555"/>

    <!-- Tab / header -->
    <SolidColorBrush x:Key="TabSelectionIndicatorBrush"     Color="#FF0078D4"/>
    <!-- The top edge of a selected rounded tab: none here, since the selected tab joins its content. -->
    <SolidColorBrush x:Key="TabItemSelectedEdgeBrush"       Color="Transparent"/>
    <SolidColorBrush x:Key="TabPanelBackgroundBrush"        Color="Transparent"/>
    <SolidColorBrush x:Key="TabItemBackgroundBrush"         Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="TabItemSelectedBackgroundBrush" Color="#FFFFFFFF"/>

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush"          Color="#FF333333"/>

    <!-- TextBox / Input -->
    <SolidColorBrush x:Key="TextBoxBackgroundBrush"         Color="White"/>
    <SolidColorBrush x:Key="TextBoxForegroundBrush"         Color="#FF333333"/>
    <SolidColorBrush x:Key="TextBoxBorderBrush"             Color="#FFBDBDBD"/>
    <SolidColorBrush x:Key="TextAreaBackgroundBrush"        Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="TextAreaBorderBrush"            Color="#FFF5F5F5"/>

    <!-- GridSplitter -->
    <SolidColorBrush x:Key="GridSplitterBrush"              Color="#FFA6A6A6"/>

    <!-- Additional keys for parity with DarkTheme -->
    <SolidColorBrush x:Key="ToolBarBackgroundBrush"         Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToolBarForegroundBrush"         Color="#FF333333"/>
    <SolidColorBrush x:Key="TabItemForegroundBrush"         Color="#FF333333"/>
    <SolidColorBrush x:Key="TabItemSelectedForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush"     Color="#FFE3E3E3"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush"   Color="#FFCCE4F7"/>
    <!-- Hover changes only the fill here; High Contrast outlines the hovered control instead. -->
    <SolidColorBrush x:Key="HoverOutlineBrush"              Color="Transparent"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush"  Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush"  Color="#FF555555"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush"         Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush"       Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush"            Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="CheckBoxForegroundBrush"        Color="#FF333333"/>

    <!-- Structure added with the W1 design: headings, outlines, dividers, the capture tab strip and table selection -->
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF9E9E9E"/>
    <SolidColorBrush x:Key="ColumnDividerBrush" Color="#4DD0D0D0"/>
    <!-- The line between column headers, where a column resizes: about 2.2:1 against the header band. -->
    <SolidColorBrush x:Key="ColumnHeaderDividerBrush" Color="#FFA0A0A0"/>
    <!-- The capturing dot beside the Stop button: 5.7:1 on the toolbar. -->
    <SolidColorBrush x:Key="RecordingIndicatorBrush" Color="#FFC42B1C"/>
    <!-- Skeleton placeholders: a quiet bar, about 1.2:1 on the recessed wells (TextAreaBackgroundBrush), and the
         lighter band that sweeps across it while content loads. -->
    <SolidColorBrush x:Key="SkeletonBaseBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="SkeletonHighlightBrush" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="#FF222222"/>
    <SolidColorBrush x:Key="PaneDividerBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="TableSelectionBorderBrush" Color="#FF0078D4"/>
    <!-- Outlines that identify a control, at 3:1 or more on every surface: check box and radio button boxes, and the
         bottom edge of inputs -->
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#FF808080"/>
    <!-- Inputs: a soft outline with a strong bottom edge. The brush is flipped, so it measures 1px up from the bottom. -->
    <LinearGradientBrush x:Key="InputBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#FF808080"/>
        <GradientStop Offset="0.5" Color="#FFBDBDBD"/>
    </LinearGradientBrush>
    <!-- The capture start action: Xbox green with a soft vertical gradient; white text stays above 4.5:1 -->
    <LinearGradientBrush x:Key="CaptureActionBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1C8C1C"/>
        <GradientStop Offset="0.5" Color="#FF107C10"/>
        <GradientStop Offset="1" Color="#FF0C6A0C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CaptureActionHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1A8A1A"/>
        <GradientStop Offset="0.5" Color="#FF138113"/>
        <GradientStop Offset="1" Color="#FF0E730E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CaptureActionPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF0E6E0E"/>
        <GradientStop Offset="1" Color="#FF0A580A"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CaptureActionBorderBrush" Color="#FF0B5C0B"/>
    <SolidColorBrush x:Key="CaptureActionForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="CaptureActionSheenBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="TabSeparatorBrush" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#FFCACACA"/>
    <!-- Inactive capture tabs: a soft inner shadow at the base, like a tab sitting behind the selected one -->
    <LinearGradientBrush x:Key="TabItemInsetShadowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.6" Color="#00000000"/>
        <GradientStop Offset="0.8" Color="#03000000"/>
        <GradientStop Offset="0.9" Color="#06000000"/>
        <GradientStop Offset="1" Color="#0A000000"/>
    </LinearGradientBrush>

    <!-- Timeline bars by response status, each with its label color, and analysis issue counts by level. Labels and
         count text are at least 4.5:1 on their fill, also under the hover and pressed fills of buttons. -->
    <SolidColorBrush x:Key="TimelineBarNoStatusBrush" Color="#FF686868"/>
    <SolidColorBrush x:Key="TimelineBarNoStatusForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="TimelineBarSuccessBrush" Color="#FF2E7D32"/>
    <SolidColorBrush x:Key="TimelineBarSuccessForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="TimelineBarRedirectBrush" Color="#FF1565C0"/>
    <SolidColorBrush x:Key="TimelineBarRedirectForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="TimelineBarClientErrorBrush" Color="#FFAD5C00"/>
    <SolidColorBrush x:Key="TimelineBarClientErrorForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="TimelineBarServerErrorBrush" Color="#FFC62828"/>
    <SolidColorBrush x:Key="TimelineBarServerErrorForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="IssueErrorBackgroundBrush" Color="#FFFDE7E9"/>
    <SolidColorBrush x:Key="IssueErrorForegroundBrush" Color="#FFC00000"/>
    <SolidColorBrush x:Key="IssueWarningBackgroundBrush" Color="#FFFFF4CE"/>
    <SolidColorBrush x:Key="IssueWarningForegroundBrush" Color="#FF8A5300"/>
    <SolidColorBrush x:Key="IssueInfoBackgroundBrush" Color="#FFDFF6DD"/>
    <SolidColorBrush x:Key="IssueInfoForegroundBrush" Color="#FF0E700E"/>

    <!-- SystemColors overrides to restore defaults when switching from dark -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="Black"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFE5F1FB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF333333"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFE5F1FB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF333333"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF6D6D6D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="Black"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FF3399FF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFE3E3E3"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF696969"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#FFB4B4B4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#FFF4F7FC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FFFFFFE1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="Black"/>

</ResourceDictionary>
