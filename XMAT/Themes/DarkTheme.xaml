<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The new look's Dark theme. Every color is a step of the palette that Palette.json generates from
         five base colors (docs/design-system.md). Views and styles use the roles; only this file and the High
         Contrast theme say which step or system color each role is. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Surfaces: window chrome and table headers, content panels and buttons, recessed wells, hover and a chosen card.
         Each level is a step apart: wells sit a step below panels and the chrome a step below wells, so a table's
         header band stands out from its rows. -->
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource Gray15}"/>
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource Gray13}"/>
    <SolidColorBrush x:Key="SurfaceWellBrush" Color="{StaticResource Gray14}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource Gray12}"/>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource Blue12}"/>

    <!-- Text: one color for all text people read, headings included, a quieter one for labels, one for disabled
         controls and one for links -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray6}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Gray8}"/>
    <SolidColorBrush x:Key="TextLinkBrush" Color="{StaticResource Blue5}"/>

    <!-- Borders: dividers and grid lines, the outline that identifies a control, and an outline under the pointer -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource Gray11}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Gray8}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource Gray8}"/>

    <!-- Accent: selection, focus and the selected tab -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Blue6}"/>
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource Blue10}"/>
    <SolidColorBrush x:Key="AccentOnFillBrush" Color="{StaticResource Gray1}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource Blue10}"/>

    <!-- Status: each has a fill, the text on that fill, text on surfaces and a soft background -->
    <SolidColorBrush x:Key="SuccessFillBrush" Color="{StaticResource Green5}"/>
    <SolidColorBrush x:Key="SuccessOnFillBrush" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource Green3}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource Green12}"/>
    <SolidColorBrush x:Key="WarningFillBrush" Color="{StaticResource Amber5}"/>
    <SolidColorBrush x:Key="WarningOnFillBrush" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource Amber4}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource Amber12}"/>
    <SolidColorBrush x:Key="ErrorFillBrush" Color="{StaticResource Red6}"/>
    <SolidColorBrush x:Key="ErrorOnFillBrush" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource Red3}"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource Red12}"/>
    <SolidColorBrush x:Key="InfoFillBrush" Color="{StaticResource Blue6}"/>
    <SolidColorBrush x:Key="InfoOnFillBrush" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="NeutralFillBrush" Color="{StaticResource Gray7}"/>
    <SolidColorBrush x:Key="NeutralOnFillBrush" Color="{StaticResource Gray16}"/>

    <!-- Component colors: each belongs to one component, and High Contrast gives it a system color of its own. -->
    <!-- Buttons: their text and outline. High contrast gives buttons the contrast theme's button text color. -->
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource Gray8}"/>
    <SolidColorBrush x:Key="TabStripBrush" Color="{StaticResource Gray16}"/>
    <SolidColorBrush x:Key="WellEdgeBrush" Color="{StaticResource Gray14}"/>
    <SolidColorBrush x:Key="SkeletonBaseBrush" Color="{StaticResource Gray11}"/>
    <SolidColorBrush x:Key="SkeletonHighlightBrush" Color="{StaticResource Gray13}"/>
    <SolidColorBrush x:Key="RecordingIndicatorBrush" Color="{StaticResource Red6}"/>
    <SolidColorBrush x:Key="CaptureActionBorderBrush" Color="{StaticResource Green11}"/>
    <SolidColorBrush x:Key="ColumnHeaderDividerBrush" Color="{StaticResource Gray10}"/>
    <SolidColorBrush x:Key="ExpanderHeaderBrush" Color="{StaticResource Gray11}"/>
    <SolidColorBrush x:Key="ExpanderSubHeaderBrush" Color="{StaticResource Gray12}"/>
    <SolidColorBrush x:Key="ExpanderDetailBrush" Color="{StaticResource Gray12}"/>
    <SolidColorBrush x:Key="ColumnDividerBrush" Color="{StaticResource Gray12}"/>
    <!-- The faint wash behind a table row whose status is a problem or needs attention (STATUS-2): the darkest red and
         amber at half strength over the table, so a washed row stays quieter than the selected one. -->
    <SolidColorBrush x:Key="ProblemRowBrush" Color="{StaticResource Red12}" Opacity="0.5"/>
    <SolidColorBrush x:Key="AttentionRowBrush" Color="{StaticResource Amber12}" Opacity="0.5"/>
    <SolidColorBrush x:Key="HoverOutlineBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItemSelectedEdgeBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="CaptureActionSheenBrush" Color="#38FFFFFF"/>
    <!-- Inputs: a soft outline with a strong bottom edge. The brush is flipped, so it measures 1px up from the bottom. -->
    <LinearGradientBrush x:Key="InputBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="{StaticResource Gray8}"/>
        <GradientStop Offset="0.5" Color="{StaticResource Gray10}"/>
    </LinearGradientBrush>
    <!-- The capture start action: Xbox green (Green 9) with a soft vertical gradient. White text stays above 4.5:1. -->
    <LinearGradientBrush x:Key="CaptureActionBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Green8}"/>
        <GradientStop Offset="0.5" Color="{StaticResource Green9}"/>
        <GradientStop Offset="1" Color="{StaticResource Green10}"/>
    </LinearGradientBrush>
    <!-- Hover lightens the lower half by one step. -->
    <LinearGradientBrush x:Key="CaptureActionHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Green8}"/>
        <GradientStop Offset="0.5" Color="{StaticResource Green9}"/>
        <GradientStop Offset="1" Color="{StaticResource Green9}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CaptureActionPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Green10}"/>
        <GradientStop Offset="1" Color="{StaticResource Green11}"/>
    </LinearGradientBrush>
    <!-- Inactive capture tabs: a soft inner shadow at the base, like a tab sitting behind the selected one -->
    <LinearGradientBrush x:Key="TabItemInsetShadowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.6" Color="#00000000"/>
        <GradientStop Offset="0.8" Color="#14000000"/>
        <GradientStop Offset="0.9" Color="#26000000"/>
        <GradientStop Offset="1" Color="#40000000"/>
    </LinearGradientBrush>

    <!-- Old names that views shared with the original look still use, each on its role's step. Remove them
         with the original look. -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource Gray15}"/>
    <SolidColorBrush x:Key="AltRowBackgroundBrush" Color="{StaticResource Gray14}"/>
    <SolidColorBrush x:Key="CapturePendingForegroundBrush" Color="{StaticResource Amber4}"/>

    <!-- Windows system colors, for built-in controls that XMAT doesn't restyle. Their text is the text color, and their chrome the canvas color. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Gray13}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Gray14}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Blue12}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Blue12}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="{StaticResource Gray15}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource Gray8}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource Gray15}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource Gray4}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource Blue12}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource Gray12}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="{StaticResource Gray14}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource Gray11}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="{StaticResource Gray15}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="{StaticResource Gray11}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="{StaticResource Gray11}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{StaticResource Amber12}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{StaticResource Gray4}"/>

</ResourceDictionary>
