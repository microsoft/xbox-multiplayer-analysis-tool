<UserControl x:Class="XMAT.SqlQueryWorkspaceView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sql="clr-namespace:XMAT.SqlQueries"
  PreviewKeyDown="View_PreviewKeyDown">
  <UserControl.Resources>
    <DataTemplate x:Key="SqlDocumentHeader">
      <StackPanel Orientation="Horizontal" Margin="3,1">
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" ToolTip="{Binding FilePath}"/>
        <Button Content="×" Click="CloseDocument_Click" Width="22" Height="22" Margin="7,0,0,0"
          Padding="0" ToolTip="{sql:SqlText SQL_CLOSE_QUERY}" AutomationProperties.Name="{sql:SqlText SQL_CLOSE_QUERY}"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel Background="{DynamicResource PanelBackgroundBrush}">
    <WrapPanel DockPanel.Dock="Top" Margin="4">
      <Button x:Name="NewQueryButton" Content="{sql:SqlText SQL_NEW_QUERY}" Click="NewQuery_Click" Padding="6,3"
        IsEnabled="{Binding CanCreateDocument}"/>
      <Button Content="{sql:SqlText SQL_OPEN}" Click="OpenQuery_Click" Padding="6,3" Margin="6,0"
        IsEnabled="{Binding CanCreateDocument}"/>
      <Button x:Name="HistoryButton" Content="{sql:SqlText SQL_HISTORY}" Click="History_Click" Padding="6,3"
        IsEnabled="{Binding CanCreateDocument}"/>
      <Button Content="{sql:SqlText SQL_SOURCES_REFRESH}" Click="RefreshSources_Click" Padding="6,3" Margin="6,0"
        IsEnabled="{Binding CanCreateDocument}"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="10,0" VerticalAlignment="Center"/>
    </WrapPanel>
    <TabControl x:Name="DocumentTabs" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
      SelectionChanged="DocumentTabs_SelectionChanged"/>
  </DockPanel>
</UserControl>
