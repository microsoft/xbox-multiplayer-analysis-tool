<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XMAT\XboxMultiplayerAnalysisTool.csproj" />
    <!-- Build order only: the tests in Cli run the built xmat.exe from XMAT.Cli's output folder. Private="false" keeps
         xmat.exe and its configuration files out of the test output, so they are never run without xmat.dll. -->
    <ProjectReference Include="..\XMAT.Cli\XMAT.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\XMAT\App.xaml" LogicalName="XMAT.Tests.App.xaml" />
    <EmbeddedResource Include="..\XMAT\Windows\MainWindow.xaml" LogicalName="XMAT.Tests.MainWindow.xaml" />
  </ItemGroup>

  <!-- Every product XAML file, so the headless-parity tests can classify its Command, Click and CommandBinding
       entry points. Logical names keep the path relative to the XMAT project. App.xaml and MainWindow.xaml are
       embedded once, above, and the parity tests read them under those names. -->
  <ItemGroup>
    <EmbeddedResource Include="..\XMAT\**\*.xaml"
                      Exclude="..\XMAT\bin\**;..\XMAT\obj\**;..\XMAT\App.xaml;..\XMAT\Windows\MainWindow.xaml"
                      LogicalName="XMAT.Tests.XamlSources\%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
  </ItemGroup>

</Project>
