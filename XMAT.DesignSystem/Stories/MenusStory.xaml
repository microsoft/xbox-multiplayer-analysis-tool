<ds:Story x:Class="XMAT.DesignSystem.MenusStory"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:ds="clr-namespace:XMAT.DesignSystem"
          Title="Menus"
          Summary="The menu bar's dropdowns and context menus share one surface: rounded, with a soft shadow, and rows with room for an icon. Context menus group their rows under labeled headers. The More menu of a tab row is on the Tabs page."
          Section="Components"
          DefinedIn="XMAT/Styles/Menus.xaml">
    <StackPanel>
        <ds:StorySection Title="Menu bar" StyleName="Menu (default style), MainMenuBarStyle, MenuItem (default style)"
                         Description="The main window's menu row, a band of window chrome. Open a menu to see its dropdown.">
            <ds:StoryExample Caption="Closed">
                <Menu Style="{DynamicResource MainMenuBarStyle}" Width="460">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New Capture" InputGestureText="Ctrl+N"/>
                        <MenuItem Header="_Open Captures" InputGestureText="Ctrl+O"/>
                        <Separator/>
                        <MenuItem Header="E_xit"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Clear All Captures"/>
                        <Separator/>
                        <MenuItem Header="_Comfort view" IsCheckable="True" IsChecked="True"/>
                        <MenuItem Header="_Preferences" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="Collect Logs"/>
                    </MenuItem>
                </Menu>
            </ds:StoryExample>
        </ds:StorySection>

        <ds:StorySection Title="Context menu"
                         StyleName="ContextMenuSurfaceStyle, MenuGroupHeader, MenuNote, MenuItem.SeparatorStyleKey"
                         Description="Opened by right-clicking a row, or from the keyboard with Shift+F10. Rows sit in labeled groups, between separators; a header names what its rows act on, and a note says why a row is missing or what else applies. Build one with GroupedMenu.">
            <ds:StoryExample x:Name="ContextMenuExample" Caption="Select or right-click to open"/>
        </ds:StorySection>
    </StackPanel>
</ds:Story>
