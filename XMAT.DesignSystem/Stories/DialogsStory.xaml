<ds:Story x:Class="XMAT.DesignSystem.DialogsStory"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sys="clr-namespace:System;assembly=mscorlib"
          xmlns:ds="clr-namespace:XMAT.DesignSystem"
          xmlns:app="clr-namespace:XMAT;assembly=XboxMultiplayerAnalysisTool"
          Title="Dialogs"
          Summary="A confirmation asks before XMAT does something that can't be undone, such as deleting sessions. It asks one question, says what the action does and what stays, and ends with the action's button beside Cancel."
          Section="Components"
          DefinedIn="XMAT/Controls/ConfirmPanel.xaml, XMAT/Windows/ConfirmWindow.cs">
    <StackPanel>
        <ds:StoryUsage>
            <ds:StoryUsage.UseFor>
                <sys:String>Asking before an action that can't be undone, such as Delete in a capture list.</sys:String>
            </ds:StoryUsage.UseFor>
            <ds:StoryUsage.NotFor>
                <sys:String>An action people can take back or repeat, such as Clear filters: do it straight away.</sys:String>
                <sys:String>Choosing options before an action, such as the device for a capture: use a window with its own fields, like New Capture.</sys:String>
            </ds:StoryUsage.NotFor>
        </ds:StoryUsage>

        <ds:StorySection Title="Confirmation" StyleName="ConfirmPanel, in ConfirmWindow, with DangerButtonStyle"
                         Description="The question names the action and how many it affects. A line says it can't be undone, the counts that matter follow, and the red button says the action again. Cancel is the default answer and has the focus, so Enter and Esc both cancel.">
            <ds:StoryExample Caption="Delete selected sessions">
                <Border BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfacePanelBrush}">
                    <app:ConfirmPanel Heading="Delete 12 sessions?" Message="This can't be undone."
                                      ConfirmText="Delete 12 sessions" IsDestructive="True">
                        <app:ConfirmPanel.Details>
                            <x:Array Type="sys:String">
                                <sys:String>Sessions that stay: 30, including 3 that filters hide</sys:String>
                            </x:Array>
                        </app:ConfirmPanel.Details>
                    </app:ConfirmPanel>
                </Border>
            </ds:StoryExample>
            <ds:StoryExample Caption="Delete the sessions that aren't selected, one without a response">
                <Border BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfacePanelBrush}">
                    <app:ConfirmPanel Heading="Delete the 4 sessions that aren't selected?" Message="This can't be undone."
                                      ConfirmText="Delete 4 sessions" IsDestructive="True">
                        <app:ConfirmPanel.Details>
                            <x:Array Type="sys:String">
                                <sys:String>Selected sessions, which stay: 2</sys:String>
                                <sys:String>Sessions that filters hide, which stay: 3</sys:String>
                                <sys:String>Sessions to delete that have no complete recorded response: 1. XMAT keeps forwarding their traffic but does not record the rest of it.</sys:String>
                            </x:Array>
                        </app:ConfirmPanel.Details>
                    </app:ConfirmPanel>
                </Border>
            </ds:StoryExample>
        </ds:StorySection>

        <ds:StoryRules Description="What every confirmation in XMAT follows. A Must rule names the tests that fail when XMAT breaks it, and their failures start with its ID.">
            <ds:StoryRule RuleId="DIALOG-1">
                <ds:RuleExample Kind="Do" Caption="The question names the action and the count, and the red button says it again. Cancel is the default.">
                    <StackPanel Width="320">
                        <TextBlock Text="Delete 12 sessions?" Style="{DynamicResource SectionTitleStyle}"
                                   Margin="{DynamicResource HeadingContentGap}"/>
                        <TextBlock Text="This can't be undone." Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource DangerButtonStyle}" Content="Delete 12 sessions" MinWidth="88"
                                    MinHeight="{DynamicResource ControlHeight}" Margin="{DynamicResource InlineGap}"/>
                            <Button Content="Cancel" MinWidth="88" MinHeight="{DynamicResource ControlHeight}"/>
                        </StackPanel>
                    </StackPanel>
                </ds:RuleExample>
                <ds:RuleExample Kind="Dont" Caption="Are you sure? and OK send people back to work out what OK does, and Enter deletes.">
                    <StackPanel Width="320">
                        <TextBlock Text="Are you sure?" Style="{DynamicResource SectionTitleStyle}"
                                   Margin="{DynamicResource HeadingContentGap}"/>
                        <TextBlock Text="The selected sessions will be deleted." Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="OK" MinWidth="88" MinHeight="{DynamicResource ControlHeight}"
                                    Margin="{DynamicResource InlineGap}"/>
                            <Button Content="Cancel" MinWidth="88" MinHeight="{DynamicResource ControlHeight}"/>
                        </StackPanel>
                    </StackPanel>
                </ds:RuleExample>
            </ds:StoryRule>
        </ds:StoryRules>
    </StackPanel>
</ds:Story>
