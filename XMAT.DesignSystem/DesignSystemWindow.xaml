<Window x:Class="XMAT.DesignSystem.DesignSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:XMAT;assembly=XboxMultiplayerAnalysisTool"
        Width="1180" Height="820" MinWidth="760" MinHeight="480"
        Title="XMAT design system" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="{DynamicResource BaseFontSize}">
    <!-- The window's resources are the new look's (DesignSystemWindow.xaml.cs), set before its content loads. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Pages, under the section each is in; selecting one shows it. Searching lists the pages that match, each with
             its matching sections under it. -->
        <DockPanel Margin="16,20,8,16">
            <TextBlock x:Name="Heading" Text="Design system" DockPanel.Dock="Top" Margin="12,0,0,4" FontSize="18"
                       FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Name="Subheading" DockPanel.Dock="Top" Margin="12,0,0,6" TextWrapping="Wrap"
                       Text="The new look's foundations and components, read from the files XMAT uses. Hover, press and Tab through the components for the rest."
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <!-- The search lines up with the entries of the list, which sit inside the list's edge and its groups' indent. -->
            <app:SearchBox x:Name="ComponentSearch" DockPanel.Dock="Top" Margin="6,10,1,0" Hint="Search components"
                           ToolTip="Finds pages and sections by their names, styles and rules. Ctrl+F comes here; Esc clears it."
                           AutomationProperties.Name="Search components"
                           TextChanged="ComponentSearch_TextChanged" PreviewKeyDown="ComponentSearch_PreviewKeyDown"/>
            <TextBlock x:Name="NoMatch" DockPanel.Dock="Top" Margin="13,14,0,0" Style="{DynamicResource NoticeTextStyle}"
                       Foreground="{DynamicResource TextSecondaryBrush}" app:LiveRegion.Mode="Polite"/>
            <ListBox x:Name="PageList" ItemContainerStyle="{DynamicResource DesignSystemPageItemStyle}"
                     AutomationProperties.Name="Pages" IsSynchronizedWithCurrentItem="False"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="PageList_SelectionChanged" PreviewKeyDown="PageList_PreviewKeyDown">
                <ListBox.Resources>
                    <!-- The new look's scroll viewers take the panel color; the list sits on the window's. -->
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Resources>
                <!-- Each section's name, above its pages. -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="12,14,0,6" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           AutomationProperties.HeadingLevel="Level3"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </DockPanel>

        <!-- The page: what it shows, what it is for and the files that define it, the preview settings, then its
             examples. -->
        <DockPanel Grid.Column="1" Margin="8,20,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,24,0">
                <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock x:Name="PageSummary" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="PageDefinedIn" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- The preview settings change this window only. -->
                <WrapPanel x:Name="PreviewSettings" Margin="0,16,0,12" AutomationProperties.Name="Preview settings">
                    <TextBlock x:Name="ThemeLabel" Text="Theme" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <RadioButton x:Name="LightTheme" Content="Light" GroupName="PreviewTheme" Margin="0,0,16,0"
                                 VerticalAlignment="Center" Checked="Theme_Checked"/>
                    <RadioButton x:Name="DarkTheme" Content="Dark" GroupName="PreviewTheme" Margin="0,0,32,0"
                                 VerticalAlignment="Center" Checked="Theme_Checked"/>
                    <TextBlock x:Name="ContrastLabel" Text="Contrast theme" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ContrastChoice" MinWidth="128" Margin="0,0,32,0" VerticalAlignment="Center"
                              AutomationProperties.LabeledBy="{Binding ElementName=ContrastLabel}"
                              ToolTipService.ShowOnDisabled="True" SelectionChanged="ContrastChoice_SelectionChanged"/>
                    <CheckBox x:Name="ComfortViewChoice" Content="Comfort view" VerticalAlignment="Center"
                              Checked="ComfortViewChoice_Changed" Unchecked="ComfortViewChoice_Changed"/>
                </WrapPanel>
            </StackPanel>
            <ScrollViewer x:Name="PageScroller" Background="Transparent" Focusable="False" Padding="0,8,24,8"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageHost" Focusable="False"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
